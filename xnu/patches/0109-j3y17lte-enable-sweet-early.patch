--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -8,11 +8,114 @@
 #include <arm64/sweet_early.h>
 
 #if defined(SWEET) && defined(J3Y17LTE)
-void sweet_early_putc(char c) { (void)c; }
-void sweet_early_mark(unsigned int stage, const char *label) { (void)stage; (void)label; }
-void sweet_early_panic(const char *fmt, va_list *args) { (void)fmt; (void)args; }
-void sweet_early_relocate(uint64_t base) { (void)base; }
-void sweet_early_disable(void) {}
+
+#include <stdint.h>
+
+/*
+ * Galaxy J3 2017 early VM-transition diagnostics.
+ *
+ * The bootstrap framebuffer aperture maps the first 2 MiB of
+ * physical framebuffer 0x67000000.
+ *
+ * Keep all diagnostic writes below scanline ~728:
+ *
+ *     2 MiB / 2880 bytes-per-row ~= 728 rows
+ *
+ * We use rows 680..699.
+ */
+static volatile uint32_t *early_fb =
+    (volatile uint32_t *)(uintptr_t)0x67000000ULL;
+
+static unsigned int early_disabled;
+
+#define J3_EARLY_STRIDE_PIXELS (2880u / 4u)
+#define J3_MARK_Y              680u
+#define J3_MARK_H              20u
+#define J3_MARK_W              24u
+#define J3_MARK_STEP           32u
+
+void
+sweet_early_putc(char c)
+{
+	(void)c;
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+	(void)label;
+
+	if (early_disabled || stage > 20) {
+		return;
+	}
+
+	unsigned int x0 = stage * J3_MARK_STEP;
+
+	/*
+	 * Give consecutive stages visibly different colours.
+	 * Position, rather than colour, is the authoritative stage ID.
+	 */
+	uint32_t colour =
+	    0xff202020u |
+	    (((stage * 53u) & 0xffu) << 16) |
+	    (((stage * 97u) & 0xffu) << 8) |
+	    ((stage * 193u) & 0xffu);
+
+	for (unsigned int y = J3_MARK_Y;
+	    y < J3_MARK_Y + J3_MARK_H;
+	    y++) {
+
+		volatile uint32_t *row =
+		    early_fb + y * J3_EARLY_STRIDE_PIXELS;
+
+		for (unsigned int x = x0;
+		    x < x0 + J3_MARK_W;
+		    x++) {
+			row[x] = colour;
+		}
+	}
+
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	(void)fmt;
+	(void)args;
+
+	/*
+	 * Stage 20 doubles as an obvious panic indicator during
+	 * early bring-up.
+	 */
+	sweet_early_mark(20, "panic");
+}
+
+void
+sweet_early_relocate(uint64_t base)
+{
+	/*
+	 * Stage 8 is drawn through the outgoing bootstrap mapping.
+	 */
+	sweet_early_mark(8, "leaving bootstrap TTBR0");
+
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/*
+	 * Stage 9 proves the permanent TTBR1 framebuffer alias works.
+	 */
+	sweet_early_mark(9, "kernel framebuffer VA live");
+}
+
+void
+sweet_early_disable(void)
+{
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 #elif defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
