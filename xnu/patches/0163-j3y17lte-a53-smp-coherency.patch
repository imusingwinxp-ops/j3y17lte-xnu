+#if defined(J3Y17LTE)
+/*
+ * Cortex-A53 CPUECTLR_EL1.SMPEN (bit 6) enables hardware management of
+ * data coherency with the other cores in the cluster.  The donor assumes
+ * firmware has already established this Apple/Qualcomm-style state; make
+ * the requirement explicit on the Exynos7570 before a secondary touches
+ * live XNU locks.
+ *
+ * Read first so firmware that already enabled SMPEN is left untouched.
+ */
+void
+j3y17lte_enable_smp_coherency(void)
+{
+	uint64_t ectlr;
+
+	__asm__ volatile("mrs %0, S3_1_C15_C2_1" : "=r"(ectlr));
+	if ((ectlr & (1ULL << 6)) == 0) {
+		ectlr |= (1ULL << 6);
+		__asm__ volatile("msr S3_1_C15_C2_1, %0" :: "r"(ectlr) : "memory");
+	}
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+#endif
+
