+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		if (j3_hw_rmi_read_once(addr, data, count)) {
+			return true;
+		}
+		j3_hw_stop();
+		if (attempt + 1 < 3) {
+			delay(20000);
+		}
+	}
+	return false;
+}
