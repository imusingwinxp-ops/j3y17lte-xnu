 	if ((startup_debug & STARTUP_DEBUG_VERBOSE) &&
 	    upto >= STARTUP_SUB_KPRINTF) {
 		kprintf("%s: reached phase %d\n", __func__, upto);
 	}
+#if defined(J3Y17LTE)
+	if (upto == STARTUP_SUB_MACH_IPC) {
+		sweet_early_mark(286, "J3XNU026 final MACH_IPC kprintf passed");
+	}
+#endif
 	startup_phase = upto;
+#if defined(J3Y17LTE)
+	if (upto == STARTUP_SUB_MACH_IPC) {
+		sweet_early_mark(287, "J3XNU026 MACH_IPC initializer returning");
+	}
+#endif
 }
 
