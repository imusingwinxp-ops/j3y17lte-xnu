--- a/osfmk/vm/vm_init.c
+++ b/osfmk/vm/vm_init.c
@@ -72,6 +72,59 @@
 TUNABLE(bool, iokit_iomd_setownership_enabled,
     "iokit_iomd_setownership_enabled", true);
 
+#if defined(J3Y17LTE)
+#include <arm/pmap.h>
+#include <arm/pmap/pmap_data.h>
+
+#define J3_BANK1_HOTADD_START ((pmap_paddr_t)0x80000000ULL)
+#define J3_BANK1_HOTADD_END   ((pmap_paddr_t)0xa1800000ULL)
+#define J3_BANK1_HOTADD_SIZE  ((vm_size_t)(J3_BANK1_HOTADD_END - J3_BANK1_HOTADD_START))
+
+extern vm_offset_t mem_size;
+extern uint64_t mem_actual;
+extern uint64_t max_mem;
+extern uint64_t max_mem_actual;
+extern uint64_t sane_size;
+extern void j3y17lte_register_hotadd_ptov(vm_map_address_t va, pmap_paddr_t pa, vm_size_t len);
+extern void j3y17lte_patch_low_glo_hotadd(uint64_t end);
+
+static void
+j3y17lte_hotadd_bank1(void)
+{
+	vm_offset_t va = 0;
+
+	/*
+	 * Reserve VA only: do not consume bank0 pages for the 536 MiB aperture.
+	 * Pmap metadata was pre-sized during pmap_data_bootstrap(), so extending
+	 * vm_last_phys before pmap_map() makes bank1 managed without touching the
+	 * nonexistent 24 MiB hole.
+	 */
+	kmem_alloc(kernel_map, &va, J3_BANK1_HOTADD_SIZE,
+	    KMA_PERMANENT | KMA_NOFAIL | KMA_KOBJECT | KMA_VAONLY,
+	    VM_KERN_MEMORY_OSFMK);
+
+	vm_last_phys = J3_BANK1_HOTADD_END;
+	vm_map_address_t mapped_end = pmap_map(va,
+	    J3_BANK1_HOTADD_START, J3_BANK1_HOTADD_END,
+	    VM_PROT_READ | VM_PROT_WRITE, VM_WIMG_USE_DEFAULT);
+	if (mapped_end != va + J3_BANK1_HOTADD_SIZE) {
+		panic("J3 HOTADD: bank1 pmap incomplete");
+	}
+
+	j3y17lte_register_hotadd_ptov(va, J3_BANK1_HOTADD_START, J3_BANK1_HOTADD_SIZE);
+	j3y17lte_patch_low_glo_hotadd(J3_BANK1_HOTADD_END);
+
+	vm_page_create((ppnum_t)atop_64(J3_BANK1_HOTADD_START),
+	    (ppnum_t)atop_64(J3_BANK1_HOTADD_END));
+
+	mem_size = 0x60000000ULL;
+	mem_actual = 0x60000000ULL;
+	max_mem = 0x60000000ULL;
+	max_mem_actual = 0x60000000ULL;
+	sane_size += J3_BANK1_HOTADD_SIZE;
+}
+#endif
