--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -496,25 +496,54 @@
 void
 sched_timeshare_init(void)
 {
+#if defined(J3Y17LTE)
+	extern void sweet_early_mark(unsigned int, const char *);
+	sweet_early_mark(121, "J3XNU023 timeshare init entered");
+#endif
 	/*
 	 * Calculate the timeslicing quantum
 	 * in us.
 	 */
 	if (default_preemption_rate < 1) {
 		default_preemption_rate = DEFAULT_PREEMPTION_RATE;
 	}
 	std_quantum_us = (1000 * 1000) / default_preemption_rate;
+#if defined(J3Y17LTE)
+	sweet_early_mark(122, "J3XNU023 foreground quantum ready");
+#endif
 
+#if !defined(J3Y17LTE)
 	printf("standard timeslicing quantum is %d us\n", std_quantum_us);
+#endif
+#if defined(J3Y17LTE)
+	sweet_early_mark(123, "J3XNU023 foreground printf bypassed");
+#endif
 
 	if (default_bg_preemption_rate < 1) {
 		default_bg_preemption_rate = DEFAULT_BG_PREEMPTION_RATE;
 	}
 	bg_quantum_us = (1000 * 1000) / default_bg_preemption_rate;
+#if defined(J3Y17LTE)
+	sweet_early_mark(124, "J3XNU023 background quantum ready");
+#endif
 
+#if !defined(J3Y17LTE)
 	printf("standard background quantum is %d us\n", bg_quantum_us);
+#endif
+#if defined(J3Y17LTE)
+	sweet_early_mark(125, "J3XNU023 background printf bypassed");
+#endif
 
 	load_shift_init();
+#if defined(J3Y17LTE)
+	sweet_early_mark(126, "J3XNU023 load shift initialized");
+#endif
 	preempt_pri_init();
+#if defined(J3Y17LTE)
+	sweet_early_mark(127, "J3XNU023 preempt priorities initialized");
+#endif
 	sched_tick = 0;
+#if defined(J3Y17LTE)
+	sweet_early_mark(128, "J3XNU023 timeshare init completed");
+#endif
 }
