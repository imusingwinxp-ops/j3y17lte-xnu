+static bool
+j3_hw_wait_pending(void)
+{
+	for (unsigned i = 0; i < 4000; i++) {
+		if (j3_rd(j3_touch_i2c, J3_IICCON) & J3_IICCON_IRQPEND) {
+			return true;
+		}
+		delay(2);
+	}
+	return false;
+}
+
+static void
+j3_hw_release(void)
+{
+	uint32_t con = j3_rd(j3_touch_i2c, J3_IICCON);
+	j3_wr(j3_touch_i2c, J3_IICCON, con & ~J3_IICCON_IRQPEND);
+}
+
+static void
+j3_hw_stop(void)
+{
+	uint32_t stat = j3_rd(j3_touch_i2c, J3_IICSTAT);
+	j3_wr(j3_touch_i2c, J3_IICSTAT, stat & ~J3_IICSTAT_START);
+	j3_hw_release();
+	for (unsigned i = 0; i < 5000; i++) {
+		if (!(j3_rd(j3_touch_i2c, J3_IICSTAT) & J3_IICSTAT_START)) {
+			break;
+		}
+		delay(1);
+	}
+	stat = j3_rd(j3_touch_i2c, J3_IICSTAT);
+	j3_wr(j3_touch_i2c, J3_IICSTAT, stat & ~J3_IICSTAT_TXRXEN);
+	uint32_t con = j3_rd(j3_touch_i2c, J3_IICCON);
+	j3_wr(j3_touch_i2c, J3_IICCON, con | J3_IICCON_ACKEN);
+}
+
+static bool
+j3_hw_start(bool read, bool repeated)
+{
+	uint32_t stat = J3_IICSTAT_TXRXEN |
+	    (read ? J3_IICSTAT_MASTER_RX : J3_IICSTAT_MASTER_TX);
+	uint32_t con = j3_rd(j3_touch_i2c, J3_IICCON) |
+	    J3_IICCON_ACKEN | J3_IICCON_IRQEN;
+	uint8_t address = (uint8_t)((J3_RMI_ADDR << 1) | (read ? 1u : 0u));
+
+	j3_wr(j3_touch_i2c, J3_IICSTAT, stat);
+	j3_wr(j3_touch_i2c, J3_IICDS, address);
+	j3_wr(j3_touch_i2c, J3_IICCON, con);
+	j3_wr(j3_touch_i2c, J3_IICSTAT, stat | J3_IICSTAT_START);
+	if (repeated) {
+		j3_hw_release();
+	}
+	if (!j3_hw_wait_pending()) {
+		return false;
+	}
+	return !(j3_rd(j3_touch_i2c, J3_IICSTAT) & J3_IICSTAT_LASTBIT);
+}
+
+static bool
+j3_hw_write_byte(uint8_t value)
+{
+	j3_wr(j3_touch_i2c, J3_IICDS, value);
+	delay(1);
+	j3_hw_release();
+	if (!j3_hw_wait_pending()) {
+		return false;
+	}
+	return !(j3_rd(j3_touch_i2c, J3_IICSTAT) & J3_IICSTAT_LASTBIT);
+}
+
+static bool
+j3_hw_write(const uint8_t *data, unsigned count)
+{
+	if (!j3_hw_start(false, false)) {
+		j3_hw_stop();
+		return false;
+	}
+	for (unsigned i = 0; i < count; i++) {
+		if (!j3_hw_write_byte(data[i])) {
+			j3_hw_stop();
+			return false;
+		}
+	}
+	j3_hw_stop();
+	return true;
+}
+
+static bool
+j3_hw_write_read(const uint8_t *prefix, unsigned prefix_count,
+	uint8_t *data, unsigned count)
+{
+	if (!count || !j3_hw_start(false, false)) {
+		j3_hw_stop();
+		return false;
+	}
+	for (unsigned i = 0; i < prefix_count; i++) {
+		if (!j3_hw_write_byte(prefix[i])) {
+			j3_hw_stop();
+			return false;
+		}
+	}
+	if (!j3_hw_start(true, true)) {
+		j3_hw_stop();
+		return false;
+	}
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t con = j3_rd(j3_touch_i2c, J3_IICCON);
+		if (i + 1 == count) {
+			con &= ~J3_IICCON_ACKEN;
+		} else {
+			con |= J3_IICCON_ACKEN;
+		}
+		j3_wr(j3_touch_i2c, J3_IICCON, con);
+		j3_hw_release();
+		if (!j3_hw_wait_pending()) {
+			j3_hw_stop();
+			return false;
+		}
+		data[i] = (uint8_t)j3_rd(j3_touch_i2c, J3_IICDS);
+	}
+	j3_hw_stop();
+	return true;
+}
+
+static bool
+j3_hw_probe(void)
+{
+	bool ok = j3_hw_start(false, false);
+	j3_hw_stop();
+	return ok;
+}
