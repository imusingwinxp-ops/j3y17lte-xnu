+static void
+j3_backlight_set(bool on)
+{
+	if (!j3_alive_gpio) {
+		j3_alive_gpio = ml_io_map(J3_ALIVE_GPIO_PA, 0x1000);
+	}
+	if (!j3_alive_gpio) {
+		return;
+	}
+	volatile uint32_t *con = (volatile uint32_t *)(j3_alive_gpio + J3_GPA1_CON);
+	volatile uint32_t *dat = (volatile uint32_t *)(j3_alive_gpio + J3_GPA1_DAT);
+	uint32_t cv = *con;
+	cv &= ~(0xfu << (J3_BLIC_PIN * 4u));
+	cv |= 1u << (J3_BLIC_PIN * 4u);
+	*con = cv;
+	__asm__ volatile("dsb oshst" ::: "memory");
+	uint32_t dv = *dat;
+	*dat = on ? (dv | (1u << J3_BLIC_PIN)) : (dv & ~(1u << J3_BLIC_PIN));
+	__asm__ volatile("dsb osh" ::: "memory");
+}
