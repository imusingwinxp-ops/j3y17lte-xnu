+	j3_wr(j3_touch_i2c, J3_IICADD, 0);
+	j3_wr(j3_touch_i2c, J3_IICLC, J3_IICLC_FILTER_ON);
+	j3_wr(j3_touch_i2c, J3_IICCON,
+	    J3_IICCON_ACKEN | J3_IICCON_TXDIV512 |
+	    J3_IICCON_IRQEN | 3u);
+	delay(20);
+	return true;
+}
