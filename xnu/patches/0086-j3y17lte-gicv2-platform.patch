+#if defined(J3Y17LTE)
+/* Exynos7570 GIC-400: distributor and CPU interface, both non-secure Group 1. */
+static vm_offset_t j3_gicd_base;
+static vm_offset_t j3_gicc_base;
+
+static uint32_t
+j3_gic_read32(vm_offset_t base, unsigned int offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static void
+j3_gic_write32(vm_offset_t base, unsigned int offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+}
+
+uint32_t
+j3y17lte_irq_ack(void)
+{
+	return j3_gic_read32(j3_gicc_base, 0x00c);
+}
+
+void
+j3y17lte_irq_eoi(uint32_t iar)
+{
+	j3_gic_write32(j3_gicc_base, 0x010, iar);
+}
+
+void
+j3y17lte_send_self_ipi(void)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	j3_gic_write32(j3_gicd_base, 0xf00, (2U << 24) | 1U);
+}
+
+void
+pe_init_fiq(void)
+{
+	DTEntry entry;
+	const void *reg;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", &reg, &size) != kSuccess ||
+	    size < 4 * sizeof(uint64_t)) {
+		panic("j3y17lte: missing GICv2 reg in ADT");
+	}
+	const uint64_t *r = reg;
+	vm_offset_t soc = pe_arm_get_soc_base_phys();
+	j3_gicd_base = ml_io_map(soc + r[0], r[1]);
+	j3_gicc_base = ml_io_map(soc + r[2], r[3]);
+	if (!j3_gicd_base || !j3_gicc_base) {
+		panic("j3y17lte: cannot map GICv2");
+	}
+	/* INTID 27 is the virtual timer PPI; SGI 1 is the local self signal. */
+	j3_gic_write32(j3_gicd_base, 0x080,
+	    j3_gic_read32(j3_gicd_base, 0x080) | (1U << 27) | (1U << 1));
+	for (unsigned int i = 0; i < 32; i += 4) {
+		j3_gic_write32(j3_gicd_base, 0x400 + i, 0xa0a0a0a0U);
+	}
+	j3_gic_write32(j3_gicd_base, 0x100, (1U << 27) | (1U << 1));
+	j3_gic_write32(j3_gicc_base, 0x004, 0xff); /* GICC_PMR */
+	j3_gic_write32(j3_gicc_base, 0x008, 0);    /* GICC_BPR */
+	j3_gic_write32(j3_gicc_base, 0x000,
+	    j3_gic_read32(j3_gicc_base, 0x000) | 1U);
+	j3_gic_write32(j3_gicd_base, 0x000,
+	    j3_gic_read32(j3_gicd_base, 0x000) | 1U);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+#else
 void
 pe_init_fiq()
 {
 }
+#endif /* J3Y17LTE */
 #endif
