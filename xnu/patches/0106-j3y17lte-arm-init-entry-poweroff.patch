--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -340,6 +340,66 @@
 arm_init(
 	boot_args       *args)
 {
+
+#if defined(J3Y17LTE)
+	/*
+	 * J3XNU005 stage 10:
+	 * execution has entered C arm_init().
+	 *
+	 * The temporary 0x67000000 TTBR0 framebuffer aperture installed
+	 * during early startup is still active here.
+	 */
+	volatile unsigned int *j3fb =
+	    (volatile unsigned int *)0x6709d860UL;
+
+	for (unsigned int y = 0; y < 16; y++) {
+		volatile unsigned int *row =
+		    (volatile unsigned int *)((unsigned long)j3fb +
+		    ((unsigned long)y * 2880UL));
+
+		for (unsigned int x = 0; x < 48; x++) {
+			row[x] = 0xff8080ffU;
+		}
+	}
+
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/*
+	 * Leave the marker visible briefly.
+	 *
+	 * J3 generic timer frequency from the recovered DT is 26 MHz.
+	 */
+	unsigned long j3_start;
+	unsigned long j3_now;
+
+	__asm__ volatile("mrs %0, cntpct_el0" : "=r"(j3_start));
+
+	do {
+		__asm__ volatile("mrs %0, cntpct_el0" : "=r"(j3_now));
+	} while ((j3_now - j3_start) < 130000000UL);
+
+	/*
+	 * PSCI SYSTEM_OFF.
+	 * J3 PSCI conduit is SMC.
+	 */
+	register unsigned long j3_psci_x0 __asm__("x0") = 0x84000008UL;
+
+	__asm__ volatile(
+	    "smc #0"
+	    : "+r"(j3_psci_x0)
+	    :
+	    : "memory"
+	);
+
+	/*
+	 * SYSTEM_OFF should not return. If firmware rejects it,
+	 * stop here instead of continuing an unintended diagnostic boot.
+	 */
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+#endif
+
 	unsigned int    maxmem;
 	uint32_t        memsize;
 	uint64_t        xmaxmem;
