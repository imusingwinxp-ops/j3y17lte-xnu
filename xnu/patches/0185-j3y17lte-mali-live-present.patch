+/*
+ * J3XNU095: once the boot-time RAM and framebuffer jobs have both proved the
+ * corrected MMU path, keep exercising JS0 from the live presentation path.
+ * This deliberately uses a tiny timestamp fence rather than touching visible
+ * pixels. If a live job ever faults, disable only this optional path and leave
+ * the CPU framebuffer fallback running.
+ */
+static void
+j3_mali_present_pulse(void)
+{
+	if (!j3_mali_live_ready || !j3_mali_live_base) {
+		return;
+	}
+	uint64_t frame = ++j3_mali_present_frames;
+	if ((frame % 120ULL) != 0) {
+		return;
+	}
+
+	if (!j3_mali_present_page) {
+		j3_mali_present_page = IOMallocAligned(4096, 4096);
+		if (!j3_mali_present_page) {
+			IOLog("J3 GPU: live present DISABLED fence allocation failed\n");
+			j3_mali_live_ready = false;
+			return;
+		}
+		bzero(j3_mali_present_page, 4096);
+		j3_mali_present_fence =
+		    (volatile uint64_t *)((uintptr_t)j3_mali_present_page + 0x100);
+		j3_mali_present_fence_pa =
+		    (uint64_t)ml_vtophys((vm_offset_t)(uintptr_t)j3_mali_present_fence);
+		if (!j3_mali_present_fence_pa) {
+			IOLog("J3 GPU: live present DISABLED fence PA unavailable\n");
+			IOFreeAligned(j3_mali_present_page, 4096);
+			j3_mali_present_page = NULL;
+			j3_mali_present_fence = NULL;
+			j3_mali_live_ready = false;
+			return;
+		}
+	}
+
+	*j3_mali_present_fence = 0;
+	flush_dcache64((addr64_t)(uintptr_t)j3_mali_present_page, 4096, FALSE);
+	bool mmuFault = false;
+	bool ok = j3_mali_write_value(j3_mali_live_base,
+	    j3_mali_present_fence_pa, J3_MALI_WRITE_TIMESTAMP,
+	    j3_mali_live_attr, "live-present fence", &mmuFault);
+	flush_dcache64((addr64_t)(uintptr_t)j3_mali_present_page, 4096, FALSE);
+	uint64_t stamp = *j3_mali_present_fence;
+	if (!ok || stamp == 0) {
+		IOLog("J3 GPU: live present FALLBACK frame=%llu ok=%d stamp=%#llx mmufault=%d\n",
+		    frame, ok, stamp, mmuFault);
+		j3_mali_live_ready = false;
+		return;
+	}
+	if (frame <= 360ULL || (frame % 600ULL) == 0) {
+		IOLog("J3 GPU: live present MALI frame=%llu stamp=%#llx attr=%u\n",
+		    frame, stamp, j3_mali_live_attr);
+	}
+}
