+/* J3XNU094: real T720 LPAE table-mode address space. */
+#define J3_MALI_MMU_IRQ_RAWSTAT         0x2000u
+#define J3_MALI_JS_COMMAND              (J3_MALI_JS0_BASE + 0x20u)
+#define J3_MALI_JS_HARD_STOP            0x03u
+#define J3_MALI_MMU_PAGE_FAULT0         (1u << 0)
+#define J3_MALI_MMU_BUS_ERROR0          (1u << 16)
+#define J3_MALI_AS_UNLOCK               0x03u
+#define J3_MALI_AS_TABLE                0x03u
+#define J3_MALI_AS_READ_INNER           0x04u
+#define J3_MALI_PT_INVALID              0x02ULL
+#define J3_MALI_PT_PTE                  0x03ULL
+#define J3_MALI_PT_ATE                  0x01ULL
+#define J3_MALI_PT_RD                   (1ULL << 6)
+#define J3_MALI_PT_WR                   (1ULL << 7)
+#define J3_MALI_PT_MAX_PAGES            8u
+#define J3_MALI_MEMATTR_R28             0x0000008d884d4f48ULL
+
+static uint32_t
+j3_gpu_read(vm_offset_t base, uint32_t offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static void
+j3_gpu_write(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+j3_gpu_rmw(vm_offset_t base, uint32_t offset, uint32_t mask, uint32_t value)
+{
+	uint32_t old = j3_gpu_read(base, offset);
+	j3_gpu_write(base, offset, (old & ~mask) | (value & mask));
+}
+
+static bool
+j3_gpu_wait_mask(vm_offset_t base, uint32_t offset, uint32_t mask,
+    uint32_t want, unsigned spins)
+{
+	for (unsigned n = 0; n < spins; n++) {
+		if ((j3_gpu_read(base, offset) & mask) == want) {
+			return true;
+		}
+		__asm__ volatile("yield");
+	}
+	return false;
+}
+
+static uint64_t
+j3_gpu_read64(vm_offset_t base, uint32_t lo, uint32_t hi)
+{
+	uint32_t h1, h2, l;
+	do {
+		h1 = j3_gpu_read(base, hi);
+		l = j3_gpu_read(base, lo);
+		h2 = j3_gpu_read(base, hi);
+	} while (h1 != h2);
+	return ((uint64_t)h2 << 32) | l;
+}
+
+/*
+ * J3XNU094 real table-mode Mali MMU.
+ *
+ * 093 proved that JS0 accepts the WRITE_VALUE chain and reaches ACTIVE, but
+ * legacy identity mode faults while fetching the descriptor. Normal kbase/
+ * Panfrost job submission uses table mode, so build a tiny clean-room LPAE
+ * tree mapping only the descriptor and target pages.
+ */
+struct j3_mali_pt_page {
+	void *va;
+	uint64_t pa;
+};
+
+struct j3_mali_pt {
+	struct j3_mali_pt_page page[J3_MALI_PT_MAX_PAGES];
+	unsigned count;
+};
+
+static int
+j3_mali_pt_alloc(struct j3_mali_pt *pt)
+{
+	if (pt->count >= J3_MALI_PT_MAX_PAGES) {
+		return -1;
+	}
+	void *va = IOMallocAligned(4096, 4096);
+	if (!va) {
+		return -1;
+	}
+	uint64_t pa = (uint64_t)ml_vtophys((vm_offset_t)va);
+	if (!pa || (pa & 0xfffULL)) {
+		IOFreeAligned(va, 4096);
+		return -1;
+	}
+	volatile uint64_t *entry = (volatile uint64_t *)va;
+	for (unsigned i = 0; i < 512; i++) {
+		entry[i] = J3_MALI_PT_INVALID;
+	}
+	unsigned idx = pt->count++;
+	pt->page[idx].va = va;
+	pt->page[idx].pa = pa;
+	return (int)idx;
+}
+
+static int
+j3_mali_pt_find(const struct j3_mali_pt *pt, uint64_t pa)
+{
+	pa &= ~0xfffULL;
+	for (unsigned i = 0; i < pt->count; i++) {
+		if ((pt->page[i].pa & ~0xfffULL) == pa) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static void
+j3_mali_pt_destroy(struct j3_mali_pt *pt)
+{
+	for (unsigned i = 0; i < pt->count; i++) {
+		if (pt->page[i].va) {
+			IOFreeAligned(pt->page[i].va, 4096);
+			pt->page[i].va = NULL;
+		}
+	}
+	pt->count = 0;
+}
+
+static bool
+j3_mali_pt_map_page(struct j3_mali_pt *pt, uint64_t gpuVA,
+    uint64_t physical, unsigned memattrIndex)
+{
+	if (!pt->count) {
+		return false;
+	}
+	gpuVA &= ~0xfffULL;
+	physical &= ~0xfffULL;
+	int table = 0;
+	static const unsigned shifts[3] = { 39, 30, 21 };
+
+	for (unsigned level = 0; level < 3; level++) {
+		volatile uint64_t *e =
+		    (volatile uint64_t *)pt->page[table].va;
+		unsigned slot = (unsigned)((gpuVA >> shifts[level]) & 0x1ffULL);
+		uint64_t v = e[slot];
+		int child;
+		if ((v & 3ULL) != J3_MALI_PT_PTE) {
+			child = j3_mali_pt_alloc(pt);
+			if (child < 0) {
+				return false;
+			}
+			e[slot] = (pt->page[child].pa & ~0xfffULL) |
+			    J3_MALI_PT_PTE;
+		} else {
+			child = j3_mali_pt_find(pt, v);
+			if (child < 0) {
+				return false;
+			}
+		}
+		table = child;
+	}
+
+	volatile uint64_t *leaf =
+	    (volatile uint64_t *)pt->page[table].va;
+	unsigned slot = (unsigned)((gpuVA >> 12) & 0x1ffULL);
+	leaf[slot] = physical |
+	    (((uint64_t)memattrIndex & 7ULL) << 2) |
+	    J3_MALI_PT_RD | J3_MALI_PT_WR | J3_MALI_PT_ATE;
+	return true;
+}
+
+static void
+j3_mali_pt_clean(struct j3_mali_pt *pt)
+{
+	for (unsigned i = 0; i < pt->count; i++) {
+		flush_dcache64((addr64_t)(uintptr_t)pt->page[i].va, 4096, FALSE);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+j3_mali_as0_disable(vm_offset_t mali)
+{
+	if (j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_LO, 0);
+		j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_HI, 0);
+		j3_gpu_write(mali, J3_MALI_AS0_COMMAND, J3_MALI_AS_UPDATE);
+		(void)j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+		    J3_MALI_AS_ACTIVE, 0, 1000000u);
+	}
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR,
+	    J3_MALI_MMU_PAGE_FAULT0 | J3_MALI_MMU_BUS_ERROR0);
+}
+
+static bool
+j3_mali_table_as0(vm_offset_t mali, struct j3_mali_pt *pt,
+    uint64_t descPA, uint64_t targetPA, unsigned memattrIndex)
+{
+	bzero(pt, sizeof(*pt));
+	if (j3_mali_pt_alloc(pt) < 0 ||
+	    !j3_mali_pt_map_page(pt, descPA, descPA, memattrIndex) ||
+	    !j3_mali_pt_map_page(pt, targetPA, targetPA, memattrIndex)) {
+		IOLog("J3 GPU: table MMU STOP page-table allocation/map failed attr=%u\n",
+		    memattrIndex);
+		j3_mali_pt_destroy(pt);
+		return false;
+	}
+	j3_mali_pt_clean(pt);
+
+	if (!j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		IOLog("J3 GPU: table MMU STOP AS0 busy status=%#x\n",
+		    j3_gpu_read(mali, J3_MALI_AS0_STATUS));
+		j3_mali_pt_destroy(pt);
+		return false;
+	}
+
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR,
+	    J3_MALI_MMU_PAGE_FAULT0 | J3_MALI_MMU_BUS_ERROR0);
+	j3_gpu_write(mali, J3_MALI_AS0_MEMATTR_LO,
+	    (uint32_t)J3_MALI_MEMATTR_R28);
+	j3_gpu_write(mali, J3_MALI_AS0_MEMATTR_HI,
+	    (uint32_t)(J3_MALI_MEMATTR_R28 >> 32));
+	uint64_t transtab = pt->page[0].pa |
+	    J3_MALI_AS_TABLE | J3_MALI_AS_READ_INNER;
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_LO, (uint32_t)transtab);
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_HI,
+	    (uint32_t)(transtab >> 32));
+	j3_gpu_write(mali, J3_MALI_AS0_COMMAND, J3_MALI_AS_UPDATE);
+
+	if (!j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		IOLog("J3 GPU: table MMU STOP UPDATE timeout status=%#x\n",
+		    j3_gpu_read(mali, J3_MALI_AS0_STATUS));
+		j3_mali_as0_disable(mali);
+		j3_mali_pt_destroy(pt);
+		return false;
+	}
+
+	IOLog("J3 GPU: table MMU PASS root=%#llx attr=%u memattr=%#x:%08x transcfg=%#x pages=%u\n",
+	    pt->page[0].pa, memattrIndex,
+	    j3_gpu_read(mali, J3_MALI_AS0_MEMATTR_HI),
+	    j3_gpu_read(mali, J3_MALI_AS0_MEMATTR_LO),
+	    j3_gpu_read(mali, J3_MALI_AS0_TRANSCFG), pt->count);
+	return true;
+}
+
+static void
+j3_mali_recover_job(vm_offset_t mali, uint32_t jobRaw, uint32_t mmuRaw)
+{
+	uint32_t status = j3_gpu_read(mali, J3_MALI_JS_STATUS);
+	if (status == 0x08u) {
+		j3_gpu_write(mali, J3_MALI_JS_COMMAND, J3_MALI_JS_HARD_STOP);
+		for (unsigned spin = 0; spin < 200000u; spin++) {
+			if (j3_gpu_read(mali, J3_MALI_JS_STATUS) != 0x08u) {
+				break;
+			}
+			__asm__ volatile("yield");
+		}
+	}
+	j3_gpu_write(mali, J3_MALI_JOB_IRQ_CLEAR,
+	    jobRaw & (J3_MALI_JOB_DONE0 | J3_MALI_JOB_FAIL0));
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR,
+	    mmuRaw & (J3_MALI_MMU_PAGE_FAULT0 | J3_MALI_MMU_BUS_ERROR0));
+	if (j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		j3_gpu_write(mali, J3_MALI_AS0_COMMAND, J3_MALI_AS_UNLOCK);
+		(void)j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+		    J3_MALI_AS_ACTIVE, 0, 1000000u);
+	}
+	IOLog("J3 GPU: recovery js=%#x jobraw=%#x mmuraw=%#x as=%#x\n",
+	    j3_gpu_read(mali, J3_MALI_JS_STATUS), jobRaw, mmuRaw,
+	    j3_gpu_read(mali, J3_MALI_AS0_STATUS));
+}
+
+static const char *
+j3_mali_fault_name(uint32_t fault)
+{
+	switch (fault & 0x38u) {
+	case 0x00u: return "TRANSLATION";
+	case 0x08u: return "PERMISSION";
+	case 0x10u: return "TRANSTAB_BUS";
+	case 0x18u: return "ACCESS_FLAG";
+	case 0x20u: return "ADDRESS_SIZE";
+	case 0x28u: return "MEMATTR";
+	default: return "UNKNOWN";
+	}
+}
+
+/*
+ * Independently encode the public Midgard-v4 WRITE_VALUE descriptor and run
+ * it through a real table-mode AS0.  On an MMU stall, report RAWSTAT and
+ * recover immediately instead of burning two million blind spins.
+ */
+static bool
+j3_mali_write_value(vm_offset_t mali, uint64_t targetPA, uint32_t writeType,
+    unsigned memattrIndex, const char *tag, bool *mmuFaultOut)
+{
+	if (mmuFaultOut) {
+		*mmuFaultOut = false;
+	}
+	if (!(j3_gpu_read(mali, J3_MALI_JS0_FEATURES) &
+	    J3_MALI_JS_FEATURE_WRITE_VALUE)) {
+		IOLog("J3 GPU: %s STOP JS0 lacks WRITE_VALUE feature js0=%#x\n",
+		    tag, j3_gpu_read(mali, J3_MALI_JS0_FEATURES));
+		return false;
+	}
+
+	void *page = IOMallocAligned(4096, 4096);
+	if (!page) {
+		IOLog("J3 GPU: %s STOP descriptor allocation failed\n", tag);
+		return false;
+	}
+	bzero(page, 4096);
+	uint64_t descPA = (uint64_t)ml_vtophys((vm_offset_t)page);
+	if (!descPA || (descPA & 0xfffULL)) {
+		IOLog("J3 GPU: %s STOP descriptor PA invalid=%#llx\n", tag, descPA);
+		IOFreeAligned(page, 4096);
+		return false;
+	}
+
+	volatile uint32_t *w = (volatile uint32_t *)page;
+	w[4] = 1u | (J3_MALI_JOB_TYPE_WRITE_VALUE << 1) | (1u << 16);
+	w[8] = (uint32_t)targetPA;
+	w[9] = (uint32_t)(targetPA >> 32);
+	w[10] = writeType;
+	flush_dcache64((addr64_t)(uintptr_t)page, 4096, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	struct j3_mali_pt pt;
+	if (!j3_mali_table_as0(mali, &pt, descPA, targetPA, memattrIndex)) {
+		IOFreeAligned(page, 4096);
+		return false;
+	}
+
+	j3_gpu_write(mali, J3_MALI_JOB_IRQ_CLEAR,
+	    J3_MALI_JOB_DONE0 | J3_MALI_JOB_FAIL0);
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR,
+	    J3_MALI_MMU_PAGE_FAULT0 | J3_MALI_MMU_BUS_ERROR0);
+	j3_gpu_write(mali, J3_MALI_JS_HEAD_NEXT_LO, (uint32_t)descPA);
+	j3_gpu_write(mali, J3_MALI_JS_HEAD_NEXT_HI, (uint32_t)(descPA >> 32));
+	uint32_t shader = j3_gpu_read(mali, J3_MALI_SHADER_READY);
+	j3_gpu_write(mali, J3_MALI_JS_AFFINITY_NEXT_LO, shader ? shader : 1u);
+	j3_gpu_write(mali, J3_MALI_JS_AFFINITY_NEXT_HI, 0);
+	j3_gpu_write(mali, J3_MALI_JS_CONFIG_NEXT, J3_MALI_JS_CFG);
+	IOLog("J3 GPU: %s submitted desc=%#llx target=%#llx attr=%u cfg=%#x affinity=%#x\n",
+	    tag, descPA, targetPA, memattrIndex, J3_MALI_JS_CFG,
+	    shader ? shader : 1u);
+	j3_gpu_write(mali, J3_MALI_JS_COMMAND_NEXT, J3_MALI_JS_START);
+
+	uint32_t irq = 0;
+	uint32_t mmuRaw = 0;
+	bool finished = false;
+	bool mmuFault = false;
+	for (unsigned spin = 0; spin < 2000000u; spin++) {
+		mmuRaw = j3_gpu_read(mali, J3_MALI_MMU_IRQ_RAWSTAT);
+		if (mmuRaw & (J3_MALI_MMU_PAGE_FAULT0 |
+		    J3_MALI_MMU_BUS_ERROR0)) {
+			mmuFault = true;
+			break;
+		}
+		irq = j3_gpu_read(mali, J3_MALI_JOB_IRQ_RAWSTAT);
+		if (irq & (J3_MALI_JOB_DONE0 | J3_MALI_JOB_FAIL0)) {
+			finished = true;
+			break;
+		}
+		__asm__ volatile("yield");
+	}
+
+	bool ok = false;
+	if (mmuFault) {
+		uint32_t fault = j3_gpu_read(mali, J3_MALI_AS0_FAULTSTATUS);
+		IOLog("J3 GPU: %s MMU FAULT raw=%#x js=%#x fault=%#x(%s) access=%#x addr=%#x:%08x\n",
+		    tag, mmuRaw, j3_gpu_read(mali, J3_MALI_JS_STATUS),
+		    fault, j3_mali_fault_name(fault), fault & 0x300u,
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTADDRESS_HI),
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTADDRESS_LO));
+		if (mmuFaultOut) {
+			*mmuFaultOut = true;
+		}
+	} else if (!finished) {
+		IOLog("J3 GPU: %s STOP timeout irq=%#x js=%#x mmuraw=%#x\n",
+		    tag, irq, j3_gpu_read(mali, J3_MALI_JS_STATUS), mmuRaw);
+	} else if (irq & J3_MALI_JOB_FAIL0) {
+		IOLog("J3 GPU: %s STOP job fault irq=%#x js=%#x\n",
+		    tag, irq, j3_gpu_read(mali, J3_MALI_JS_STATUS));
+	} else {
+		IOLog("J3 GPU: %s completed irq=%#x js=%#x attr=%u\n",
+		    tag, irq, j3_gpu_read(mali, J3_MALI_JS_STATUS),
+		    memattrIndex);
+		ok = true;
+	}
+
+	if (!ok) {
+		j3_mali_recover_job(mali, irq, mmuRaw);
+	} else {
+		j3_gpu_write(mali, J3_MALI_JOB_IRQ_CLEAR,
+		    irq & (J3_MALI_JOB_DONE0 | J3_MALI_JOB_FAIL0));
+	}
+	j3_mali_as0_disable(mali);
+	j3_mali_pt_destroy(&pt);
+	IOFreeAligned(page, 4096);
+	return ok;
+}
+
+static bool
+j3_mali_real_job_tests(vm_offset_t mali)
+{
+	void *resultPage = IOMallocAligned(4096, 4096);
+	if (!resultPage) {
+		IOLog("J3 GPU: real job STOP result allocation failed\n");
+		return false;
+	}
+	bzero(resultPage, 4096);
+	volatile uint64_t *sentinel =
+	    (volatile uint64_t *)((uintptr_t)resultPage + 0x100);
+	uint64_t sentinelPA =
+	    (uint64_t)ml_vtophys((vm_offset_t)(uintptr_t)sentinel);
+	if (!sentinelPA) {
+		IOLog("J3 GPU: real job STOP sentinel PA unavailable\n");
+		IOFreeAligned(resultPage, 4096);
+		return false;
+	}
+
+	unsigned chosenAttr = 2;
+	*sentinel = 0x1122334455667788ULL;
+	flush_dcache64((addr64_t)(uintptr_t)resultPage, 4096, FALSE);
+	bool mmuFault = false;
+	bool ramJob = j3_mali_write_value(mali, sentinelPA,
+	    J3_MALI_WRITE_ZERO, chosenAttr, "write-value RAM A", &mmuFault);
+
+	if (!ramJob && mmuFault) {
+		chosenAttr = 0;
+		*sentinel = 0x1122334455667788ULL;
+		flush_dcache64((addr64_t)(uintptr_t)resultPage, 4096, FALSE);
+		IOLog("J3 GPU: retrying RAM job with default MEMATTR index 0\n");
+		bool retryFault = false;
+		ramJob = j3_mali_write_value(mali, sentinelPA,
+		    J3_MALI_WRITE_ZERO, chosenAttr, "write-value RAM B",
+		    &retryFault);
+	}
+
+	flush_dcache64((addr64_t)(uintptr_t)resultPage, 4096, FALSE);
+	uint64_t result = *sentinel;
+	bool ramVerified = ramJob && result == 0;
+	IOLog("J3 GPU: memory write %s result=%#llx target=%#llx attr=%u\n",
+	    ramVerified ? "VERIFIED" : "FAILED", result, sentinelPA,
+	    chosenAttr);
+	IOFreeAligned(resultPage, 4096);
+
+	if (!ramVerified) {
+		IOLog("J3 GPU: real-job summary RAM=FAIL FB=SKIP; CPU present remains active\n");
+		return false;
+	}
+
+	uint64_t fbTarget = J3_MALI_FB_PA +
+	    (J3_MALI_FB_H - 1) * J3_MALI_FB_STRIDE +
+	    (J3_MALI_FB_W - 2) * 4;
+	uint64_t fbPagePA = fbTarget & ~0xfffULL;
+	uint32_t fbOff = (uint32_t)(fbTarget & 0xfffULL);
+	vm_offset_t fbMap = ml_io_map((vm_offset_t)fbPagePA, 0x1000);
+	bool fbVerified = false;
+	if (!fbMap || fbOff > 0xff8u) {
+		IOLog("J3 GPU: framebuffer GPU write SKIP map=%#lx off=%#x\n",
+		    (unsigned long)fbMap, fbOff);
+	} else {
+		volatile uint64_t *fbPair = (volatile uint64_t *)(fbMap + fbOff);
+		uint64_t old = *fbPair;
+		bool fbFault = false;
+		bool fbJob = j3_mali_write_value(mali, fbTarget,
+		    J3_MALI_WRITE_TIMESTAMP, chosenAttr, "write-value FB",
+		    &fbFault);
+		__asm__ volatile("dsb sy" ::: "memory");
+		uint64_t gpu = *fbPair;
+		fbVerified = fbJob && gpu != old;
+		*fbPair = old;
+		__asm__ volatile("dsb sy" ::: "memory");
+		IOLog("J3 GPU: framebuffer GPU write %s old=%#llx gpu=%#llx target=%#llx restored=yes attr=%u\n",
+		    fbVerified ? "PASS" : "FAILED", old, gpu, fbTarget,
+		    chosenAttr);
+	}
+
 	IOLog("J3 GPU: real-job summary RAM=%s FB=%s; CPU present remains active\n",
 	    ramVerified ? "PASS" : "FAIL", fbVerified ? "PASS" : "FAIL");
 	return ramVerified && fbVerified;
