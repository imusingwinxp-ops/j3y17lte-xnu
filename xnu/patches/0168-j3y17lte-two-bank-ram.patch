@@ -370,3 +370,10 @@
 #define PTOV_TABLE_SIZE 8
+#if defined(J3Y17LTE)
+#define J3_RAM_BANK0_END    ((pmap_paddr_t)0x7e800000ULL)
+#define J3_RAM_BANK1_START  ((pmap_paddr_t)0x80000000ULL)
+#define J3_RAM_BANK1_END    ((pmap_paddr_t)0xc0000000ULL)
+#define J3_RAM_SPAN_SIZE    ((uint64_t)0x80000000ULL)
+#define J3_RAM_USABLE_SIZE  ((uint64_t)0x7e800000ULL)
+#endif
 SECURITY_READ_ONLY_LATE(static ptov_table_entry)        ptov_table[PTOV_TABLE_SIZE];
 SECURITY_READ_ONLY_LATE(static boolean_t)               kva_active = FALSE;
@@ -1684,8 +1691,24 @@
 	arm_vm_page_granular_RWNX(end_kern, phystokv(args->topOfKernelData) - end_kern,
 	    ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT); /* Device Tree (if not locked down), RAM Disk (if present), bootArgs */
 
+#if defined(J3Y17LTE)
+	if (args->topOfKernelData >= J3_RAM_BANK0_END) {
+		panic("J3 RAM: topOfKernelData outside bank0 (0x%llx)", args->topOfKernelData);
+	}
+	/* Finish bank0, then create an independent aperture segment for bank1.
+	 * No mapping is created for 0x7e800000..0x80000000. */
+	arm_vm_physmap_slide(temp_ptov_table,
+	    (args->topOfKernelData - gPhysBase + gVirtBase),
+	    J3_RAM_BANK0_END - args->topOfKernelData,
+	    AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT);
+	arm_vm_physmap_slide(temp_ptov_table,
+	    gVirtBase + (J3_RAM_BANK1_START - gPhysBase),
+	    J3_RAM_BANK1_END - J3_RAM_BANK1_START,
+	    AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT);
+#else
 	arm_vm_physmap_slide(temp_ptov_table, (args->topOfKernelData - gPhysBase + gVirtBase),
 	    real_avail_end - args->topOfKernelData, AP_RWNA, ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT); // rest of physmem
+#endif
 
 	assert((temp_ptov_table[ptov_index - 1].va + temp_ptov_table[ptov_index - 1].len) <= physmap_end);
 
@@ -1952,8 +1975,14 @@
 	static_memory_end = phystokv(args->topOfKernelData);
