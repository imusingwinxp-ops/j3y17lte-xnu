 #else
+#if defined(J3Y17LTE)
+	/* The final J3 physmap packs bank0 + bank1 and deliberately omits the hole. */
+	static_memory_end = physmap_base + J3_RAM_USABLE_SIZE + ARM64_PHYSMAP_ALIGNMENT_PADDING;
+	physmap_end = physmap_base + J3_RAM_USABLE_SIZE + ARM64_PHYSMAP_ALIGNMENT_PADDING;
+#else
 	static_memory_end = physmap_base + mem_size + ARM64_PHYSMAP_ALIGNMENT_PADDING; // worst possible case for block alignment
 	physmap_end = physmap_base + real_phys_size + ARM64_PHYSMAP_ALIGNMENT_PADDING;
+#endif
 #endif // ARM_LARGE_MEMORY
 #endif
 
