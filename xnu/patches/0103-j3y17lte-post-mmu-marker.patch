--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -750,6 +750,49 @@
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(J3Y17LTE)
+        /*
+         * J3XNU003: temporary identity mapping for S-Boot framebuffer.
+         *
+         * 4K translation granule:
+         *   L2 block = 2 MiB
+         *
+         * 0x67000000 is 2 MiB aligned and lies in a different
+         * L1 region from the 0x80000000 XNU RAM aperture.
+         */
+
+        /* Allocate one extra L2 page. */
+        add             x2, x2, PGBYTES
+
+        /* Clear the complete new L2 page. */
+        mov             x6, x2
+        mov             x7, #(TTE_PGENTRIES)
+
+Lj3_fb_l2_zero:
+        str             xzr, [x6], #(1 << TTE_SHIFT)
+        subs            x7, x7, #1
+        b.ne            Lj3_fb_l2_zero
+
+        MOV64           x10, 0x67000000
+
+        /* Install L1 -> new L2 table. */
+        create_l1_table_entry x10, x1, x2, x6, x7, x8
+
+        /*
+         * L2 block:
+         *   VA 0x67000000 -> PA 0x67000000
+         *   write-combine / non-executable
+         */
+        MOV64   x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+
+        orr             x11, x11, x10
+
+        and             x12, x10, #(ARM_TT_L2_INDEX_MASK)
+        lsr             x12, x12, #(ARM_TT_L2_SHIFT)
+
+        str             x11, [x2, x12, lsl #TTE_SHIFT]
+#endif
+
 #if defined(SWEET) && !defined(J3Y17LTE)
 	/*
 	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
@@ -967,6 +1010,34 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(J3Y17LTE)
+        /*
+         * J3XNU003 stage 4:
+         * if RED appears, execution survived MMU enable.
+         */
+        MOV64   x10, 0x67049260
+        MOV64   x11, 0xffff0000
+        mov             x12, #16
+        mov             x15, #2880
+
+Lj3_stage4_row:
+        mov             x14, x10
+        mov             x13, #48
+
+Lj3_stage4_col:
+        str             w11, [x14], #4
+        subs            x13, x13, #1
+        b.ne            Lj3_stage4_col
+
+        dsb             sy
+
+        add             x10, x10, x15
+        subs            x12, x12, #1
+        b.ne            Lj3_stage4_row
+
+        dsb             sy
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
