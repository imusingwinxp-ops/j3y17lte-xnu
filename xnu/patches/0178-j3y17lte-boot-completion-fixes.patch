+		int step = 50 * scale;
+#if defined(J3Y17LTE)
+		/*
+		 * The J3's 720-pixel panel can make Apple's boot-progress
+		 * centering step overshoot below zero.  Saturate at zero instead
+		 * of panicking; this preserves the progress renderer and removes
+		 * the need for -noprogress.
