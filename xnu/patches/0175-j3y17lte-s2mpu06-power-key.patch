+/*
+ * J3Y17LTE side power-key bridge.
+ *
+ * Samsung's J3Y17LTE DTS routes KEY_POWER through the S2MPU06 PMIC on
+ * Exynos SPEEDY, not through the normal Exynos GPIO-key banks.  Samsung's
+ * s2mpu06 key driver defines STATUS1 (PMIC device 1, register 0x06), bit 0
+ * as the physical PWRON state.  Poll that read-only status and feed the
+ * existing SweetHID consumer Power usage (key 0).
+ */
+#if defined(ARM64_BOARD_CONFIG_J3Y17LTE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+
+#define J3_SPEEDY_PA                    0x10510000u
+#define J3_SPEEDY_SIZE                  0x2000u
+
+#define J3_SPEEDY_CTRL                  0x000u
+#define J3_SPEEDY_FIFO_CTRL             0x004u
+#define J3_SPEEDY_CMD                   0x008u
+#define J3_SPEEDY_INT_ENABLE            0x00cu
+#define J3_SPEEDY_INT_STATUS            0x010u
+#define J3_SPEEDY_RX_DATA               0x038u
+
+#define J3_IPBATCHER_CON                0x0500u
+#define J3_IPBATCHER_STATE              0x0504u
+#define J3_IPBATCHER_INT_EN             0x0508u
+#define J3_IPBATCHER_FSM_UNEXPEN        0x050cu
+#define J3_IPBATCHER_FSM_TXEN           0x0510u
+#define J3_IPBATCHER_FSM_RXFIFO         0x0514u
+#define J3_IPBATCHER_FSM_CON            0x0518u
+#define J3_IP_INT_STATUS                0x0520u
+#define J3_IPBATCHER_SEMA_REL           0x0200u
+#define J3_BATCHER_OPCODE               0x0600u
+#define J3_BATCHER_PAYLOAD              0x1000u
+
+#define J3_SPEEDY_ENABLE                (1u << 0)
+#define J3_SPEEDY_FIFO_RESET            (1u << 31)
+#define J3_SPEEDY_RX_TRIGGER_LEVEL(x)   ((uint32_t)(x) << 0)
+#define J3_SPEEDY_TX_TRIGGER_LEVEL(x)   ((uint32_t)(x) << 8)
+#define J3_SPEEDY_ADDRESS(x)            (((uint32_t)(x) & 0xfffu) << 7)
+#define J3_SPEEDY_ACCESS_RANDOM         (1u << 19)
+
+#define J3_SPEEDY_TRANSFER_DONE         (1u << 0)
+#define J3_SPEEDY_TIMEOUT_CMD           (1u << 1)
+#define J3_SPEEDY_TIMEOUT_STANDBY       (1u << 2)
+#define J3_SPEEDY_TIMEOUT_DATA          (1u << 3)
+#define J3_SPEEDY_FIFO_TX_EMPTY         (1u << 4)
+#define J3_SPEEDY_FIFO_RX_FULL          (1u << 8)
+#define J3_SPEEDY_RX_TRAILER            (1u << 9)
+#define J3_SPEEDY_RX_MODEBIT_ERR        (1u << 16)
+#define J3_SPEEDY_RX_GLITCH_ERR         (1u << 17)
+#define J3_SPEEDY_RX_ENDBIT_ERR         (1u << 18)
+#define J3_SPEEDY_TX_LINE_BUSY_ERR      (1u << 20)
+#define J3_SPEEDY_TX_STOPBIT_ERR        (1u << 21)
+#define J3_SPEEDY_FIFO_EMPTY            (1u << 6)
+
+#define J3_BATCHER_ENABLE               (1u << 0)
+#define J3_BATCHER_DEDICATED_APB        (1u << 1)
+#define J3_BATCHER_START                (1u << 4)
+#define J3_BATCHER_OPERATION_COMPLETE   (1u << 0)
+#define J3_BATCHER_UNEXPECTED_INTR      (1u << 1)
+#define J3_BATCHER_DISABLE_STOP_CMD     (1u << 0)
+
+#define J3_S2MPU06_STATUS1_ADDR         0x106u
+#define J3_S2MPU06_PWRON                (1u << 0)
+
+static vm_offset_t j3_speedy;
+static int j3_power_sleep_chan;
+
+static inline uint32_t
+j3_power_rd(uint32_t off)
+{
+    uint32_t v = *(volatile uint32_t *)(j3_speedy + off);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return v;
+}
+
+static inline void
+j3_power_wr(uint32_t off, uint32_t v)
+{
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(j3_speedy + off) = v;
+    __asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+j3_power_sleep(unsigned ms)
+{
+    uint64_t deadline;
+    clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+    (void)assert_wait_deadline(&j3_power_sleep_chan, THREAD_UNINT, deadline);
+    thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+j3_speedy_read_status1(uint8_t *value)
+{
+    const uint32_t int_enable =
+        J3_SPEEDY_TIMEOUT_CMD | J3_SPEEDY_TIMEOUT_STANDBY |
+        J3_SPEEDY_TIMEOUT_DATA | J3_SPEEDY_FIFO_TX_EMPTY |
+        J3_SPEEDY_FIFO_RX_FULL | J3_SPEEDY_RX_TRAILER |
+        J3_SPEEDY_RX_MODEBIT_ERR | J3_SPEEDY_RX_GLITCH_ERR |
+        J3_SPEEDY_RX_ENDBIT_ERR;
+    const uint32_t error_mask =
+        J3_SPEEDY_TIMEOUT_CMD | J3_SPEEDY_TIMEOUT_STANDBY |
+        J3_SPEEDY_TIMEOUT_DATA | J3_SPEEDY_RX_MODEBIT_ERR |
+        J3_SPEEDY_RX_GLITCH_ERR | J3_SPEEDY_RX_ENDBIT_ERR |
+        J3_SPEEDY_TX_LINE_BUSY_ERR | J3_SPEEDY_TX_STOPBIT_ERR;
+    const uint32_t fifo =
+        J3_SPEEDY_FIFO_RESET | J3_SPEEDY_RX_TRIGGER_LEVEL(1) |
+        J3_SPEEDY_TX_TRIGGER_LEVEL(1);
+    const uint32_t cmd =
+        J3_SPEEDY_ADDRESS(J3_S2MPU06_STATUS1_ADDR) |
+        J3_SPEEDY_ACCESS_RANDOM;
+
+    /*
+     * Fixed seven-operation read program, matching Samsung's SPEEDY batcher:
+     * CTRL, FIFO_CTRL, INT_STATUS, INT_ENABLE, CMD, RX_DATA, END.
+     * The RX_DATA result is written back into payload slot 5.
+     */
+    j3_power_wr(J3_IPBATCHER_CON, 0);
+    j3_power_wr(J3_BATCHER_OPCODE + 0, 0x0c100400u);
+    j3_power_wr(J3_BATCHER_OPCODE + 4, 0xffff3808u);
+    j3_power_wr(J3_BATCHER_PAYLOAD + 0, 0x00030051u);
+    j3_power_wr(J3_BATCHER_PAYLOAD + 4, fifo);
+    j3_power_wr(J3_BATCHER_PAYLOAD + 8, 0xffffffffu);
+    j3_power_wr(J3_BATCHER_PAYLOAD + 12, int_enable);
+    j3_power_wr(J3_BATCHER_PAYLOAD + 16, cmd);
+    j3_power_wr(J3_BATCHER_PAYLOAD + 20, 0x77u);
+    j3_power_wr(J3_BATCHER_PAYLOAD + 24, 0);
+
+    j3_power_wr(J3_IPBATCHER_FSM_UNEXPEN, error_mask);
+    j3_power_wr(J3_IPBATCHER_FSM_TXEN,
+        J3_SPEEDY_TRANSFER_DONE | J3_SPEEDY_FIFO_TX_EMPTY);
+    j3_power_wr(J3_IPBATCHER_FSM_RXFIFO, J3_SPEEDY_FIFO_EMPTY);
+    j3_power_wr(J3_IPBATCHER_FSM_CON, J3_BATCHER_DISABLE_STOP_CMD);
+    j3_power_wr(J3_IPBATCHER_INT_EN, 1);
+    j3_power_wr(J3_IPBATCHER_CON,
+        J3_BATCHER_ENABLE | J3_BATCHER_DEDICATED_APB);
+    j3_power_wr(J3_IPBATCHER_CON,
+        J3_BATCHER_ENABLE | J3_BATCHER_DEDICATED_APB | J3_BATCHER_START);
+
+    uint32_t state = 0;
+    bool complete = false;
+    for (unsigned i = 0; i < 5000; i++) {
+        state = j3_power_rd(J3_IPBATCHER_STATE);
+        if (state & (J3_BATCHER_OPERATION_COMPLETE |
+            J3_BATCHER_UNEXPECTED_INTR)) {
+            complete = true;
+            break;
+        }
+        delay(1);
+    }
+
+    uint32_t istat = j3_power_rd(J3_IP_INT_STATUS);
+    bool ok = complete &&
+        (state & J3_BATCHER_OPERATION_COMPLETE) &&
+        !(state & J3_BATCHER_UNEXPECTED_INTR) &&
+        !(istat & error_mask);
+
+    if (ok) {
+        *value = (uint8_t)j3_power_rd(J3_BATCHER_PAYLOAD + 20);
+    }
+
+    if (state & J3_BATCHER_OPERATION_COMPLETE) {
+        j3_power_wr(J3_IPBATCHER_STATE,
+            state | J3_BATCHER_OPERATION_COMPLETE);
+    }
+    j3_power_wr(J3_IPBATCHER_INT_EN, 0);
+    j3_power_wr(J3_IPBATCHER_CON, 0);
+
+    if (!ok) {
+        /* Do not let an optional key reader interfere with the working boot. */
+        j3_power_wr(J3_IPBATCHER_SEMA_REL, 1);
+    }
+    return ok;
+}
+
+static void
+j3_power_thread(void *arg, wait_result_t result)
+{
+    (void)arg;
+    (void)result;
+
+    uint8_t status = 0;
+    if (!j3_speedy_read_status1(&status)) {
+        printf("J3 INPUT: power SPEEDY STATUS1 unavailable; power key disabled\n");
+        return;
+    }
+
+    int stable = !!(status & J3_S2MPU06_PWRON);
+    int candidate = stable;
+    unsigned repeated = 0;
+
+    printf("J3 INPUT: power online SPEEDY=0x10510000 STATUS1=%#x state=%d\n",
+        status, stable);
+
+    for (;;) {
+        if (!j3_speedy_read_status1(&status)) {
+            j3_power_sleep(20);
+            continue;
+        }
+
+        int sample = !!(status & J3_S2MPU06_PWRON);
+        if (sample == candidate) {
+            if (repeated < 2) {
+                repeated++;
+            }
+        } else {
+            candidate = sample;
+            repeated = 0;
+        }
+
+        if (repeated == 2 && stable != candidate) {
+            stable = candidate;
+            printf("J3 INPUT: power down=%d STATUS1=%#x\n", stable, status);
+            sweet_hid_key(0, stable);
+        }
+        j3_power_sleep(10);
+    }
+}
+
+void
+j3y17lte_power_init(void)
+{
+    j3_speedy = ml_io_map(J3_SPEEDY_PA, J3_SPEEDY_SIZE);
+    if (!j3_speedy) {
+        printf("J3 INPUT: power SPEEDY map failed\n");
+        return;
+    }
+
+    /* Linux releases any stale direct-access semaphore before batcher use. */
+    j3_power_wr(J3_IPBATCHER_SEMA_REL, 1);
+
+    thread_t thread;
+    kern_return_t kr = kernel_thread_start(
+        (thread_continue_t)j3_power_thread, NULL, &thread);
+    if (kr == KERN_SUCCESS) {
+        thread_deallocate(thread);
+    } else {
+        printf("J3 INPUT: power thread start failed kr=%d\n", kr);
+    }
+}
+#endif /* ARM64_BOARD_CONFIG_J3Y17LTE */
