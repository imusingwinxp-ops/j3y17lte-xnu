 	msr		DAIFSet, #0xf
 	mrs		x1, CurrentEL
+#if defined(J3Y17LTE)
+	/* 0x10 + EL: proves PSCI entered the secondary and records incoming EL. */
+	mrs		x9, MPIDR_EL1
+	and		x9, x9, #0xff
+	adrp	x10, EXT(j3_secondary_stage)@page
+	add		x10, x10, EXT(j3_secondary_stage)@pageoff
+	lsr		x11, x1, #2
+	add		x11, x11, #0x10
+	str		w11, [x10, x9, lsl #2]
+	dsb		sy
+#endif
 	cmp		x1, #0x4
