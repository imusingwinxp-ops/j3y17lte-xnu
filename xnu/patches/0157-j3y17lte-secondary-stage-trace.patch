 Lsweet_secondary_el1:
+#if defined(J3Y17LTE)
+	mrs		x9, MPIDR_EL1
+	and		x9, x9, #0xff
+	adrp	x10, EXT(j3_secondary_stage)@page
+	add		x10, x10, EXT(j3_secondary_stage)@pageoff
+	mov		w11, #0x20
