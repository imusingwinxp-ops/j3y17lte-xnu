--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -10,5 +10,17 @@ _cnputc(char c, bool poll)
 		_cnputc('\r', poll);
 	}
 
+#if defined(J3Y17LTE)
+	/*
+	 * J3XNU037: mirror normal XNU console output to the J3's permanent
+	 * framebuffer alias once KPRINTF startup has completed. Panics keep
+	 * using the existing barcode diagnostics.
+	 */
+	extern void j3_fbconsole_putc(char);
+	if (startup_phase >= STARTUP_SUB_KPRINTF && !panic_active()) {
+		j3_fbconsole_putc(c);
+	}
+#endif
+
 	cons_ops[idx].putc(c, poll);
 }
