diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -37,7 +37,78 @@ void
 sweet_early_putc(char c)
 {
-	(void)c;
+	/*
+	 * J3XNU037: compact verbose console in the safely mapped top portion
+	 * of the J3 framebuffer. Keep this self-contained so it does not
+	 * depend on later marker-layout patches.
+	 *
+	 * 720 px / 8 px = 90 columns
+	 * 21 rows * 16 px = 336 scanlines
+	 */
+	static unsigned int text_row;
+	static unsigned int text_col;
+	static unsigned int text_started;
+	extern unsigned char iso_font[256 * 16];
+	enum {
+		TEXT_WIDTH = 720,
+		TEXT_CELL_W = 8,
+		TEXT_CELL_H = 16,
+		TEXT_COLS = TEXT_WIDTH / TEXT_CELL_W,
+		TEXT_ROWS = 21,
+	};
+
+	if (early_disabled) {
+		return;
+	}
+
+	if (!text_started) {
+		text_started = 1u;
+		for (unsigned int y = 0; y < TEXT_CELL_H; y++) {
+			volatile uint32_t *line =
+			    early_fb + y * J3_EARLY_STRIDE_PIXELS;
+			for (unsigned int x = 0; x < TEXT_WIDTH; x++) {
+				line[x] = 0xff000000u;
+			}
+		}
+	}
+
+	if (c == '\r') {
+		text_col = 0u;
+		return;
+	}
+
+	if (c == '\b') {
+		if (text_col != 0u) {
+			text_col--;
+		}
+		return;
+	}
+
+	if (c == '\n' || text_col >= TEXT_COLS) {
+		text_col = 0u;
+		text_row = (text_row + 1u) % TEXT_ROWS;
+		for (unsigned int y = text_row * TEXT_CELL_H;
+		    y < (text_row + 1u) * TEXT_CELL_H; y++) {
+			volatile uint32_t *line =
+			    early_fb + y * J3_EARLY_STRIDE_PIXELS;
+			for (unsigned int x = 0; x < TEXT_WIDTH; x++) {
+				line[x] = 0xff000000u;
+			}
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (c == '\n') {
+			return;
+		}
+	}
+
+	if ((unsigned char)c < 0x20u) {
+		return;
+	}
+
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16u;
+	unsigned int x0 = text_col * TEXT_CELL_W;
+	unsigned int y0 = text_row * TEXT_CELL_H;
+	for (unsigned int gy = 0; gy < 16u; gy++) {
+		volatile uint32_t *line =
+		    early_fb + (y0 + gy) * J3_EARLY_STRIDE_PIXELS + x0;
+		for (unsigned int gx = 0; gx < 8u; gx++) {
+			line[gx] = (glyph[gy] & (1u << gx)) ?
+			    0xffffffffu : 0xff000000u;
+		}
+	}
+	text_col++;
+	__asm__ volatile("dsb sy" ::: "memory");
 }
 
 void
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -238,6 +238,16 @@ _cnputc(char c, bool poll)
 	if (c == '\n') {
 		_cnputc('\r', poll);
 	}
 
+#if defined(J3Y17LTE)
+	/*
+	 * J3XNU037: mirror the normal XNU console stream into the proven
+	 * early/permanent J3 framebuffer alias. Stop mirroring once panic
+	 * handling begins so the existing panic barcodes remain intact.
+	 */
+	extern void sweet_early_putc(char);
+	if (!panic_active()) {
+		sweet_early_putc(c);
+	}
+#endif
+
 	cons_ops[idx].putc(c, poll);
 }
