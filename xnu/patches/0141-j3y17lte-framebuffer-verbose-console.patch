diff --git a/osfmk/arm64/j3_fbconsole.c b/osfmk/arm64/j3_fbconsole.c
new file mode 100644
index 0000000..e91f224
--- /dev/null
+++ b/osfmk/arm64/j3_fbconsole.c
@@ -0,0 +1,99 @@
+/*
+ * J3XNU037: minimal framebuffer console for Galaxy J3 2017 bring-up.
+ *
+ * arm_vm_init maps the first 2 MiB of physical framebuffer 0x67000000 at
+ * VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE before KPRINTF startup.  Keep text
+ * within scanlines 0..335 so the lower marker/barcode diagnostics remain
+ * available.
+ */
+
+#include <stdint.h>
+#include <mach/vm_param.h>
+#include <arm64/proc_reg.h>
+#include <pexpert/arm64/board_config.h>
+
+#if defined(J3Y17LTE)
+
+#define J3_FBCON_WIDTH          720u
+#define J3_FBCON_STRIDE_PIXELS (2880u / 4u)
+#define J3_FBCON_CELL_W         8u
+#define J3_FBCON_CELL_H         16u
+#define J3_FBCON_COLS           (J3_FBCON_WIDTH / J3_FBCON_CELL_W)
+#define J3_FBCON_ROWS           21u
+#define J3_FBCON_FG             0xffffffffu
+#define J3_FBCON_BG             0xff000000u
+
+extern unsigned char iso_font[256 * 16];
+
+static volatile uint32_t * const j3_fbcon =
+    (volatile uint32_t *)(uintptr_t)(VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE);
+
+static unsigned int j3_fbcon_row;
+static unsigned int j3_fbcon_col;
+static unsigned int j3_fbcon_started;
+
+static void
+j3_fbconsole_clear_row(unsigned int row)
+{
+	for (unsigned int y = row * J3_FBCON_CELL_H;
+	    y < (row + 1u) * J3_FBCON_CELL_H; y++) {
+		volatile uint32_t *line =
+		    j3_fbcon + y * J3_FBCON_STRIDE_PIXELS;
+		for (unsigned int x = 0; x < J3_FBCON_WIDTH; x++) {
+			line[x] = J3_FBCON_BG;
+		}
+	}
+}
+
+void
+j3_fbconsole_putc(char c)
+{
+	if (!j3_fbcon_started) {
+		j3_fbcon_started = 1u;
+		j3_fbconsole_clear_row(0u);
+	}
+
+	if (c == '\r') {
+		j3_fbcon_col = 0u;
+		return;
+	}
+
+	if (c == '\b') {
+		if (j3_fbcon_col != 0u) {
+			j3_fbcon_col--;
+		}
+		return;
+	}
+
+	if (c == '\n' || j3_fbcon_col >= J3_FBCON_COLS) {
+		j3_fbcon_col = 0u;
+		j3_fbcon_row = (j3_fbcon_row + 1u) % J3_FBCON_ROWS;
+		j3_fbconsole_clear_row(j3_fbcon_row);
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (c == '\n') {
+			return;
+		}
+	}
+
+	if ((unsigned char)c < 0x20u) {
+		return;
+	}
+
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16u;
+	unsigned int x0 = j3_fbcon_col * J3_FBCON_CELL_W;
+	unsigned int y0 = j3_fbcon_row * J3_FBCON_CELL_H;
+
+	for (unsigned int gy = 0; gy < 16u; gy++) {
+		volatile uint32_t *line =
+		    j3_fbcon + (y0 + gy) * J3_FBCON_STRIDE_PIXELS + x0;
+		for (unsigned int gx = 0; gx < 8u; gx++) {
+			line[gx] = (glyph[gy] & (1u << gx)) ?
+			    J3_FBCON_FG : J3_FBCON_BG;
+		}
+	}
+
+	j3_fbcon_col++;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+#endif /* J3Y17LTE */
