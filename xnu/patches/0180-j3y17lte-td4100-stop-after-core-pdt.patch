--- a/bsd/dev/j3y17lte_input.c
+++ b/bsd/dev/j3y17lte_input.c
@@ -680,8 +680,12 @@
 static bool
 j3_rmi_discover(void)
 {
+	static unsigned dumped_transport;
+	unsigned transport_bit = j3_touch_hw_i2c ? 1u : 2u;
+	bool dump = !(dumped_transport & transport_bit);
+
 	j3_f01_ctrl = 0;
 	j3_f12_query = j3_f12_ctrl = j3_f12_data = 0;
 
 	for (unsigned page = 0; page < J3_RMI_PAGES; page++) {
@@ -701,11 +705,12 @@
 				}
 				return false;
 			}
-			if (page == 0 && reg == J3_RMI_PDT_START) {
-				printf("J3 INPUT: TD4100 PDT0 e9=%02x:%02x:%02x:%02x:%02x:%02x via %s\n",
-				    fd[0], fd[1], fd[2], fd[3], fd[4], fd[5],
-				    j3_touch_hw_i2c ? "HW-I2C" : "GPIO");
-			}
 			if (fd[5] == 0) {
 				break;
 			}
+			if (dump) {
+				printf("J3 INPUT: TD4100 PDT p%u r=%#x F%02x q=%02x c=%02x d=%02x intr=%u via %s\n",
+				    page, reg, fd[5], fd[0], fd[2], fd[3], fd[4] & 7u,
+				    j3_touch_hw_i2c ? "HW-I2C" : "GPIO");
+			}
 			if (fd[5] == J3_RMI_F01) {
 				j3_f01_ctrl = (uint16_t)((page << 8) | fd[2]);
 			} else if (fd[5] == J3_RMI_F12) {
@@ -713,9 +718,22 @@
 				j3_f12_ctrl = (uint16_t)((page << 8) | fd[2]);
 				j3_f12_data = (uint16_t)((page << 8) | fd[3]);
 			}
+			/*
+			 * This bridge only consumes F01 and F12.  Do not keep probing
+			 * unrelated higher PDT pages after both core functions are known;
+			 * a later optional-page I/O failure must not invalidate them.
+			 */
+			if (j3_f01_ctrl && j3_f12_query && j3_f12_ctrl && j3_f12_data) {
+				if (dump) {
+					printf("J3 INPUT: TD4100 core PDT ready F01=%#x F12 q=%#x c=%#x d=%#x via %s\n",
+					    j3_f01_ctrl, j3_f12_query, j3_f12_ctrl, j3_f12_data,
+					    j3_touch_hw_i2c ? "HW-I2C" : "GPIO");
+				}
+				dumped_transport |= transport_bit;
+				return true;
+			}
 		}
 	}
-	return j3_f01_ctrl && j3_f12_query && j3_f12_ctrl && j3_f12_data;
+	if (dump) {
+		printf("J3 INPUT: TD4100 PDT incomplete F01=%#x F12 q=%#x c=%#x d=%#x via %s\n",
+		    j3_f01_ctrl, j3_f12_query, j3_f12_ctrl, j3_f12_data,
+		    j3_touch_hw_i2c ? "HW-I2C" : "GPIO");
+		dumped_transport |= transport_bit;
+	}
+	return false;
 }
