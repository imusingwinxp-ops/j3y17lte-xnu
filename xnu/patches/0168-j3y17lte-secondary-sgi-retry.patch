--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -168,5 +168,18 @@
 		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
 		    !sweet_cpu_signal_is_enabled(i)) {
+#if defined(J3Y17LTE)
+			/*
+			 * J3 secondaries start late.  initCPU() can publish initialized
+			 * before the secondary has completed ml_init_interrupt(), so the
+			 * one-shot self-SGI can remain unobserved.  Once initCPU has
+			 * completed, have CPU0 periodically re-issue SGI1 until the
+			 * normal XNU signal-enabled handshake is observed.  Do not relax
+			 * the handshake: make delivery reliable instead.
+			 */
+			if (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) != 0) {
+				j3y17lte_send_ipi(i);
+			}
+#endif
 			if (mach_absolute_time() > deadline) {
 #if defined(J3Y17LTE)
 				if (i < 4) {
@@ -210,8 +223,12 @@
 #else
 				IOLog(CPU_PORT_NAME " CPU: cpu=%u mpidr=0x%x NOT alive after 5s\n",
 				    i, topology->cpus[i].phys_id);
 				panic(CPU_PORT_NAME " CPU: cpu=%u startup timeout (reset/MMU/GIC/SGI)", i);
 #endif
 			}
-			IOSleep(1);
+#if defined(J3Y17LTE)
+			IOSleep(5);
+#else
+			IOSleep(1);
+#endif
 		}
