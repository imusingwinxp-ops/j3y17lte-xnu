+static bool
+j3_mali_map_md_range(struct j3_mali_pt *pt, IOMemoryDescriptor *memory,
+    uint32_t memoryOffset, uint64_t gpuVA, uint64_t bytes, unsigned attr)
+{
+	if (!memory || (memoryOffset & 0xfffu) || (gpuVA & 0xfffULL) ||
+	    (bytes & 0xfffULL)) {
+		return false;
+	}
+	uint64_t done = 0;
+	while (done < bytes) {
+		IOByteCount segLen = 0;
+		addr64_t pa = memory->getPhysicalSegment(
+		    (IOByteCount)memoryOffset + (IOByteCount)done, &segLen,
+		    kIOMemoryMapperNone);
+		if (!pa || !segLen || (pa & 0xfffULL)) {
+			return false;
+		}
+		uint64_t chunk = (uint64_t)segLen;
+		if (chunk > bytes - done) {
+			chunk = bytes - done;
+		}
+		if ((chunk & 0xfffULL) && chunk != bytes - done) {
+			return false;
+		}
+		for (uint64_t off = 0; off < chunk; off += 0x1000ULL) {
+			if (!j3_mali_pt_map_page(pt, gpuVA + done + off,
+			    (uint64_t)pa + off, attr)) {
+				return false;
+			}
+		}
+		done += chunk;
+	}
+	return true;
+}
