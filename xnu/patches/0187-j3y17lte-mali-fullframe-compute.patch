+static bool
+j3_mali_compute_program_as0(vm_offset_t mali)
+{
+	struct j3_mali_compute_ctx *c = &j3_mali_compute;
+	if (!c->pt.count) {
+		return false;
+	}
+	j3_mali_as0_disable(mali);
+	if (!j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		return false;
+	}
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR,
+	    J3_MALI_MMU_PAGE_FAULT0 | J3_MALI_MMU_BUS_ERROR0);
+	j3_gpu_write(mali, J3_MALI_AS0_MEMATTR_LO,
+	    (uint32_t)J3_MALI_MEMATTR_UPSTREAM);
+	j3_gpu_write(mali, J3_MALI_AS0_MEMATTR_HI,
+	    (uint32_t)(J3_MALI_MEMATTR_UPSTREAM >> 32));
+	uint64_t transtab = c->pt.page[0].pa |
+	    J3_MALI_AS_TABLE | J3_MALI_AS_READ_INNER;
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_LO, (uint32_t)transtab);
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	j3_gpu_write(mali, J3_MALI_AS0_COMMAND, J3_MALI_AS_UPDATE);
+	if (!j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		return false;
+	}
+	return true;
+}
+
+static void
+j3_mali_compute_recover(vm_offset_t mali, uint32_t jobRaw, uint32_t mmuRaw)
+{
+	if (j3_gpu_read(mali, J3_MALI_JS1_STATUS) == 0x08u) {
+		j3_gpu_write(mali, J3_MALI_JS1_COMMAND, J3_MALI_JS_HARD_STOP);
+		for (unsigned spin = 0; spin < 200000u; spin++) {
+			if (j3_gpu_read(mali, J3_MALI_JS1_STATUS) != 0x08u) {
+				break;
+			}
+			__asm__ volatile("yield");
+		}
+	}
+	j3_gpu_write(mali, J3_MALI_JOB_IRQ_CLEAR,
+	    jobRaw & (J3_MALI_JOB_DONE1 | J3_MALI_JOB_FAIL1));
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR,
+	    mmuRaw & (J3_MALI_MMU_PAGE_FAULT0 | J3_MALI_MMU_BUS_ERROR0));
+}
