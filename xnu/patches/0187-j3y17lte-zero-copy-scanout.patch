+	    oldShadow | J3_DECON_WIN_PROTECT(win));
+	j3_decon_write(J3_DECON_VIDW_ADD0(win), pa);
+	j3_decon_write(J3_DECON_SHADOWCON, oldShadow);
+	j3_decon_write(J3_DECON_UPDATE,
+	    j3_decon_read(J3_DECON_UPDATE) | J3_DECON_UPDATE_STANDALONE);
+	if (j3_decon_read(J3_DECON_VIDW_ADD0(win)) != pa) {
+		j3_decon_direct_disabled = true;
+		IOLog("J3 FB: direct scanout FALLBACK base readback failed win=%u pa=%#x\n",
+		    win, pa);
+		return false;
+	}
+	j3_decon_direct_active = pa != fallbackPA;
+	return true;
+}
+
+static void
+j3_decon_restore_cpu(uint32_t fallbackPA)
+{
+	if (!j3_decon_direct_active) {
+		return;
+	}
+	if (j3_decon_set_base(fallbackPA, fallbackPA)) {
+		IOLog("J3 FB: direct scanout -> CPU framebuffer fallback pa=%#x\n",
+		    fallbackPA);
+	}
+	j3_decon_direct_active = false;
+	OSSafeReleaseNULL(j3_decon_scanout_surface);
+}
+
+static bool
+j3_decon_present_surface(SweetSurface *s, uintptr_t src, uint32_t fallbackPA,
+    uint32_t rowBytes, uint32_t height)
+{
+	if (!j3_decon_direct_allowed() || !s || !s->memory ||
+	    s->pixelFormat != SWEET_FB_FORMAT_BGRA) {
+		return false;
+	}
+	uint64_t bytes = (uint64_t)rowBytes * height;
+	IOByteCount span = 0;
+	addr64_t pa = s->memory->getPhysicalSegment(s->offset, &span,
+	    kIOMemoryMapperNone);
+	if (!pa || span < bytes || pa > 0xffffffffULL ||
+	    bytes > 0x100000000ULL - pa || (pa & 63ULL)) {
+		if (j3_decon_direct_fail_logs++ < 8) {
+			IOLog("J3 FB: direct scanout surface rejected pa=%#llx span=%llu need=%llu fmt=%#x\n",
+			    pa, (uint64_t)span, bytes, s->pixelFormat);
+		}
+		return false;
+	}
