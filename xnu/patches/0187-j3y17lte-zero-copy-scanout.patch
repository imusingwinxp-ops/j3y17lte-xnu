+	if (frame <= 8 || (frame % 600ULL) == 0) {
+		IOLog("J3 FB: direct scanout frame=%llu win=%d pa=%#llx bytes=%llu\n",
+		    frame, j3_decon_scanout_win, pa, bytes);
+	}
+	return true;
+}
