+	return false;
+}
+
+static bool
+j3_decon_set_base(uint32_t pa, uint32_t fallbackPA)
+{
+	if (!j3_decon_probe(fallbackPA)) {
+		return false;
+	}
+	unsigned win = (unsigned)j3_decon_scanout_win;
