+#if defined(ARM64_BOARD_CONFIG_J3Y17LTE)
+/*
+ * J3XNU097 zero-copy presentation.
+ *
+ * Samsung's Exynos7570 source describes DECON0 at 0x14830000. The
+ * bootloader already has one of its three windows scanning the XNU boot
+ * framebuffer at 0x67000000. Rather than reprogramming the display mode,
+ * locate that existing window and only replace VIDW_ADD0 with a physically
+ * contiguous IOSurface address. Geometry, format, channel and timing remain
+ * exactly as the bootloader configured them.
+ *
+ * This removes the kernel CPU memcpy from the full-screen present path. It
+ * is deliberately independent of the 096 Mali proof jobs: Mali stays powered
+ * and exercised, while DECON handles scanout. Fragmented/multi-layer frames
+ * fall back to the proven CPU framebuffer path.
+ */
+#define J3_DECON0_PA                    0x14830000u
+#define J3_DECON0_SIZE                  0x8000u
+#define J3_DECON_SHADOWCON              0x0030u
+#define J3_DECON_WINCON(_w)             (0x0050u + ((_w) * 4u))
+#define J3_DECON_WIN_ENABLE             (1u << 0)
+#define J3_DECON_VIDW_ADD0(_w)          (0x0880u + ((_w) * 0x10u))
+#define J3_DECON_UPDATE                 0x0710u
+#define J3_DECON_UPDATE_STANDALONE      (1u << 0)
+#define J3_DECON_WIN_PROTECT(_w)        (1u << (8u + (_w)))
+#define J3_DECON_MAX_WIN                3u
+
+static vm_offset_t j3_decon0;
+static int j3_decon_scanout_win = -1;
+static bool j3_decon_direct_active;
+static bool j3_decon_direct_disabled;
+static bool j3_decon_direct_checked;
+static bool j3_decon_direct_requested = true;
+static uint64_t j3_decon_direct_frames;
+static uint32_t j3_decon_direct_fail_logs;
+static SweetSurface *j3_decon_scanout_surface;
+
+static inline uint32_t
+j3_decon_read(uint32_t off)
+{
+	return *(volatile uint32_t *)(j3_decon0 + off);
+}
+
+static inline void
+j3_decon_write(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(j3_decon0 + off) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static bool
+j3_decon_direct_allowed(void)
+{
+	if (!j3_decon_direct_checked) {
+		uint32_t enabled = 1;
+		PE_parse_boot_argn("j3fb_direct", &enabled, sizeof(enabled));
+		j3_decon_direct_requested = enabled != 0;
+		j3_decon_direct_checked = true;
+		IOLog("J3 FB: direct scanout %s (j3fb_direct=%u)\n",
+		    j3_decon_direct_requested ? "enabled" : "disabled", enabled);
+	}
+	return j3_decon_direct_requested && !j3_decon_direct_disabled;
+}
+
+static bool
+j3_decon_probe(uint32_t fallbackPA)
+{
+	if (j3_decon_scanout_win >= 0) {
+		return true;
+	}
+	if (!j3_decon_direct_allowed()) {
+		return false;
+	}
+	if (!j3_decon0) {
+		j3_decon0 = ml_io_map(J3_DECON0_PA, J3_DECON0_SIZE);
+	}
+	if (!j3_decon0) {
+		j3_decon_direct_disabled = true;
+		IOLog("J3 FB: direct scanout FALLBACK DECON map failed\n");
+		return false;
+	}
