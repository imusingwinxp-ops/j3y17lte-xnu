+		CleanPoC_DcacheRegion_Force( \
+		    (vm_offset_t)&j3_secondary_stage[cpu_data_ptr->cpu_number], \
+		    sizeof(j3_secondary_stage[cpu_data_ptr->cpu_number])); \
