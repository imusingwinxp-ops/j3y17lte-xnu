+static uint8_t
+j3y17lte_current_cpu_target_mask(void)
+{
+	/*
+	 * GICv2 does not require CPU-interface target bits to match XNU's
+	 * logical CPU numbers. ITARGETSR0-7 are banked/read-only for SGIs/PPIs
+	 * and expose the current CPU interface's physical target mask.
+	 * Fold the four bytes exactly like Linux irq-gic does.
+	 */
+	for (unsigned int i = 0; i < 32; i += 4) {
+		uint32_t mask = j3_gic_read32(j3_gicd_base, 0x800 + i);
+		mask |= mask >> 16;
+		mask |= mask >> 8;
+		mask &= 0xffU;
+		if (mask != 0) {
+			return (uint8_t)mask;
+		}
+	}
+	return 0;
+}
