+#if defined(J3Y17LTE)
+/*
+ * J3XNU074: install the late bank1 direct-map like a physmap/backdoor
+ * mapping. pmap_map() is deliberately not used here: it routes the target
+ * PAs through pmap_enter() and PV bookkeeping. A permanent physical aperture
+ * alias must not be represented as a normal tracked mapping.
+ *
+ * The VA was reserved with KMA_VAONLY. Expand kernel page tables lazily as
+ * required, then write normal cacheable RAM PTEs directly.
+ */
+vm_map_address_t
+j3y17lte_pmap_map_ram_bd(
+	vm_map_address_t virt,
+	vm_offset_t start,
+	vm_offset_t end,
+	vm_prot_t prot)
+{
+	const pt_attr_t * const pt_attr = pmap_get_pt_attr(kernel_pmap);
+	vm_map_address_t vaddr = virt;
+	vm_offset_t paddr = start;
+
+	while (paddr < end) {
+		pt_entry_t *ptep = pmap_pte(kernel_pmap, vaddr);
+		if (ptep == PT_ENTRY_NULL) {
+			kern_return_t kr;
+			do {
+				kr = pmap_expand(kernel_pmap, vaddr, 0,
+				    pt_attr_leaf_level(pt_attr));
+			} while (kr == KERN_ABORTED);
+			if (kr != KERN_SUCCESS) {
+				panic("J3 HOTADD: pmap_expand failed kr=%d va=%p",
+				    kr, (void *)vaddr);
+			}
+			ptep = pmap_pte(kernel_pmap, vaddr);
+			if (ptep == PT_ENTRY_NULL) {
+				panic("J3 HOTADD: no PTE after expand va=%p",
+				    (void *)vaddr);
+			}
+		}
+
+		if (*ptep != ARM_PTE_TYPE_FAULT) {
+			panic("J3 HOTADD: direct-map VA already populated va=%p pte=0x%llx",
+			    (void *)vaddr, (uint64_t)*ptep);
+		}
+
+		pt_entry_t pte = pa_to_pte(paddr) |
+		    ARM_PTE_TYPE | ARM_PTE_AF | ARM_PTE_NX | ARM_PTE_PNX |
+		    ARM_PTE_AP((prot & VM_PROT_WRITE) ? AP_RWNA : AP_RONA) |
+		    ARM_PTE_ATTRINDX(CACHE_ATTRINDX_DEFAULT) |
+		    ARM_PTE_SH(SH_OUTER_MEMORY);
+#if __ARM_KERNEL_PROTECT__
+		pte |= ARM_PTE_NG;
+#endif
+		write_pte_strong(ptep, pte);
+
+		vaddr += PAGE_SIZE;
+		paddr += PAGE_SIZE;
+	}
+
+	if (end > start) {
+		flush_mmu_tlb_region(virt, (unsigned)(end - start));
+	}
+	return vaddr;
+}
+#endif
