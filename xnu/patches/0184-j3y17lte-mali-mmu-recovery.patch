+#define J3_MALI_AS0_FAULTADDRESS_HI     0x2424u
+#define J3_MALI_AS0_STATUS              0x2428u
+#define J3_MALI_AS0_TRANSCFG_LO         0x2430u
+#define J3_MALI_AS0_TRANSCFG_HI         0x2434u
+#define J3_MALI_AS_IDENTITY             0x2u
+#define J3_MALI_AS_READ_INNER           0x4u
+#define J3_MALI_AS_UPDATE               0x1u
+#define J3_MALI_AS_UNLOCK               0x3u
+#define J3_MALI_AS_ACTIVE               0x1u
+#define J3_MALI_JS_START                0x1u
+#define J3_MALI_JS_HARD_STOP_0          0x5u
+#define J3_MALI_JS_ACTIVE               0x8u
+#define J3_MALI_JS_CFG                  ((3u << 8) | (1u << 10) | (3u << 12) | (8u << 16))
+#define J3_MALI_JOB_DONE0               (1u << 0)
+#define J3_MALI_JOB_FAIL0               (1u << 16)
