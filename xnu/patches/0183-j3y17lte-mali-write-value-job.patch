+
+static uint32_t
+j3_gpu_read(vm_offset_t base, uint32_t offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static void
+j3_gpu_write(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+j3_gpu_rmw(vm_offset_t base, uint32_t offset, uint32_t mask, uint32_t value)
+{
+	uint32_t old = j3_gpu_read(base, offset);
+	j3_gpu_write(base, offset, (old & ~mask) | (value & mask));
+}
+
+static bool
+j3_gpu_wait_mask(vm_offset_t base, uint32_t offset, uint32_t mask,
+    uint32_t want, unsigned spins)
+{
+	for (unsigned n = 0; n < spins; n++) {
+		if ((j3_gpu_read(base, offset) & mask) == want) {
+			return true;
+		}
+		__asm__ volatile("yield");
+	}
+	return false;
+}
+
+static uint64_t
+j3_gpu_read64(vm_offset_t base, uint32_t lo, uint32_t hi)
+{
+	uint32_t h1, h2, l;
+	do {
+		h1 = j3_gpu_read(base, hi);
+		l = j3_gpu_read(base, lo);
+		h2 = j3_gpu_read(base, hi);
+	} while (h1 != h2);
+	return ((uint64_t)h2 << 32) | l;
+}
+
+/*
+ * Configure T720 legacy LPAE address space 0 in identity mode.  T720's
+ * public feature table does not advertise the AArch64 MMU feature.
+ */
+static bool
+j3_mali_identity_as0(vm_offset_t mali)
+{
+	const uint64_t memattr =
+	    (0x48ULL << 0) | (0x4fULL << 8) | (0x4dULL << 16) |
+	    (0x88ULL << 24) | (0x8dULL << 32);
+	if (!j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		IOLog("J3 GPU: identity MMU STOP AS0 busy status=%#x\n",
+		    j3_gpu_read(mali, J3_MALI_AS0_STATUS));
+		return false;
+	}
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR, 0xffffffffu);
+	j3_gpu_write(mali, J3_MALI_AS0_MEMATTR_LO, (uint32_t)memattr);
+	j3_gpu_write(mali, J3_MALI_AS0_MEMATTR_HI, (uint32_t)(memattr >> 32));
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_LO, J3_MALI_AS_IDENTITY);
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_HI, 0);
+	j3_gpu_write(mali, J3_MALI_AS0_COMMAND, J3_MALI_AS_UPDATE);
+	if (!j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u)) {
+		IOLog("J3 GPU: identity MMU STOP UPDATE timeout status=%#x\n",
+		    j3_gpu_read(mali, J3_MALI_AS0_STATUS));
+		return false;
+	}
+	IOLog("J3 GPU: identity MMU PASS transtab=%#x memattr=%#x:%08x\n",
+	    j3_gpu_read(mali, J3_MALI_AS0_TRANSTAB_LO),
+	    j3_gpu_read(mali, J3_MALI_AS0_MEMATTR_HI),
+	    j3_gpu_read(mali, J3_MALI_AS0_MEMATTR_LO));
+	return true;
+}
+
+static void
+j3_mali_as0_unmap(vm_offset_t mali)
+{
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_LO, 0);
+	j3_gpu_write(mali, J3_MALI_AS0_TRANSTAB_HI, 0);
+	j3_gpu_write(mali, J3_MALI_AS0_COMMAND, J3_MALI_AS_UPDATE);
+	(void)j3_gpu_wait_mask(mali, J3_MALI_AS0_STATUS,
+	    J3_MALI_AS_ACTIVE, 0, 1000000u);
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR, 0xffffffffu);
+}
+
+/*
+ * Independently encode the public Midgard v4 WRITE_VALUE descriptor.
+ * One aligned wired page is enough for the 64-byte job descriptor.
+ */
+static bool
+j3_mali_write_value(vm_offset_t mali, uint64_t targetPA, uint32_t writeType,
+    const char *tag)
+{
+	if (!(j3_gpu_read(mali, J3_MALI_JS0_FEATURES) &
+	    J3_MALI_JS_FEATURE_WRITE_VALUE)) {
+		IOLog("J3 GPU: %s STOP JS0 lacks WRITE_VALUE feature js0=%#x\n",
+		    tag, j3_gpu_read(mali, J3_MALI_JS0_FEATURES));
+		return false;
+	}
+	void *page = IOMallocAligned(4096, 4096);
+	if (!page) {
+		IOLog("J3 GPU: %s STOP descriptor allocation failed\n", tag);
+		return false;
+	}
+	bzero(page, 4096);
+	uint64_t descPA = (uint64_t)ml_vtophys((vm_offset_t)page);
+	if (!descPA) {
+		IOLog("J3 GPU: %s STOP descriptor PA unavailable\n", tag);
+		IOFreeAligned(page, 4096);
+		return false;
+	}
+
+	volatile uint32_t *w = (volatile uint32_t *)page;
+	w[4] = 1u | (J3_MALI_JOB_TYPE_WRITE_VALUE << 1) | (1u << 16);
+	w[8] = (uint32_t)targetPA;
+	w[9] = (uint32_t)(targetPA >> 32);
+	w[10] = writeType;
+	flush_dcache64((addr64_t)(uintptr_t)page, 4096, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	j3_gpu_write(mali, J3_MALI_JOB_IRQ_CLEAR,
+	    J3_MALI_JOB_DONE0 | J3_MALI_JOB_FAIL0);
+	j3_gpu_write(mali, J3_MALI_JS_HEAD_NEXT_LO, (uint32_t)descPA);
+	j3_gpu_write(mali, J3_MALI_JS_HEAD_NEXT_HI, (uint32_t)(descPA >> 32));
+	uint32_t shader = j3_gpu_read(mali, J3_MALI_SHADER_READY);
+	j3_gpu_write(mali, J3_MALI_JS_AFFINITY_NEXT_LO, shader ? shader : 1u);
+	j3_gpu_write(mali, J3_MALI_JS_AFFINITY_NEXT_HI, 0);
+	j3_gpu_write(mali, J3_MALI_JS_CONFIG_NEXT, J3_MALI_JS_CFG);
+	IOLog("J3 GPU: %s submitted desc=%#llx target=%#llx type=%u cfg=%#x affinity=%#x\n",
+	    tag, descPA, targetPA, writeType, J3_MALI_JS_CFG,
+	    shader ? shader : 1u);
+	j3_gpu_write(mali, J3_MALI_JS_COMMAND_NEXT, J3_MALI_JS_START);
+
+	uint32_t irq = 0;
+	bool finished = false;
+	for (unsigned spin = 0; spin < 2000000u; spin++) {
+		irq = j3_gpu_read(mali, J3_MALI_JOB_IRQ_RAWSTAT);
+		if (irq & (J3_MALI_JOB_DONE0 | J3_MALI_JOB_FAIL0)) {
+			finished = true;
+			break;
+		}
+		__asm__ volatile("yield");
+	}
+
+	bool ok = false;
+	if (!finished) {
+		IOLog("J3 GPU: %s STOP timeout irq=%#x js=%#x mmu=%#x fault=%#x@%#x:%08x\n",
+		    tag, irq, j3_gpu_read(mali, J3_MALI_JS_STATUS),
+		    j3_gpu_read(mali, J3_MALI_MMU_IRQ_STATUS),
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTSTATUS),
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTADDRESS_HI),
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTADDRESS_LO));
+	} else if (irq & J3_MALI_JOB_FAIL0) {
+		IOLog("J3 GPU: %s STOP job fault irq=%#x js=%#x mmu=%#x fault=%#x@%#x:%08x\n",
+		    tag, irq, j3_gpu_read(mali, J3_MALI_JS_STATUS),
+		    j3_gpu_read(mali, J3_MALI_MMU_IRQ_STATUS),
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTSTATUS),
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTADDRESS_HI),
+		    j3_gpu_read(mali, J3_MALI_AS0_FAULTADDRESS_LO));
+	} else {
+		IOLog("J3 GPU: %s completed irq=%#x js=%#x\n",
+		    tag, irq, j3_gpu_read(mali, J3_MALI_JS_STATUS));
+		ok = true;
+	}
+	j3_gpu_write(mali, J3_MALI_JOB_IRQ_CLEAR,
+	    irq & (J3_MALI_JOB_DONE0 | J3_MALI_JOB_FAIL0));
+	j3_gpu_write(mali, J3_MALI_MMU_IRQ_CLEAR, 0xffffffffu);
+	IOFreeAligned(page, 4096);
+	return ok;
+}
+
+static bool
+j3_mali_real_job_tests(vm_offset_t mali)
+{
+	if (!j3_mali_identity_as0(mali)) {
+		return false;
+	}
+
+	void *resultPage = IOMallocAligned(4096, 4096);
+	if (!resultPage) {
+		IOLog("J3 GPU: real job STOP result allocation failed\n");
+		j3_mali_as0_unmap(mali);
+		return false;
+	}
+	bzero(resultPage, 4096);
+	volatile uint64_t *sentinel =
+	    (volatile uint64_t *)((uintptr_t)resultPage + 0x100);
+	*sentinel = 0x1122334455667788ULL;
+	flush_dcache64((addr64_t)(uintptr_t)resultPage, 4096, FALSE);
+	uint64_t sentinelPA =
+	    (uint64_t)ml_vtophys((vm_offset_t)(uintptr_t)sentinel);
+	bool ramJob = sentinelPA &&
+	    j3_mali_write_value(mali, sentinelPA, J3_MALI_WRITE_ZERO,
+	    "write-value RAM");
+	flush_dcache64((addr64_t)(uintptr_t)resultPage, 4096, FALSE);
+	uint64_t result = *sentinel;
+	bool ramVerified = ramJob && result == 0;
+	IOLog("J3 GPU: memory write %s result=%#llx target=%#llx\n",
+	    ramVerified ? "VERIFIED" : "FAILED", result, sentinelPA);
+	IOFreeAligned(resultPage, 4096);
+
+	if (!ramVerified) {
+		j3_mali_as0_unmap(mali);
+		return false;
+	}
+
+	uint64_t fbTarget = J3_MALI_FB_PA +
+	    (J3_MALI_FB_H - 1) * J3_MALI_FB_STRIDE +
+	    (J3_MALI_FB_W - 2) * 4;
+	uint64_t fbPagePA = fbTarget & ~0xfffULL;
+	uint32_t fbOff = (uint32_t)(fbTarget & 0xfffULL);
+	vm_offset_t fbMap = ml_io_map((vm_offset_t)fbPagePA, 0x1000);
+	bool fbVerified = false;
+	if (!fbMap || fbOff > 0xff8u) {
+		IOLog("J3 GPU: framebuffer GPU write SKIP map=%#lx off=%#x\n",
+		    (unsigned long)fbMap, fbOff);
+	} else {
+		volatile uint64_t *fbPair = (volatile uint64_t *)(fbMap + fbOff);
+		uint64_t old = *fbPair;
+		bool fbJob = j3_mali_write_value(mali, fbTarget,
+		    J3_MALI_WRITE_TIMESTAMP, "write-value FB");
+		__asm__ volatile("dsb sy" ::: "memory");
+		uint64_t gpu = *fbPair;
+		fbVerified = fbJob && gpu != old;
+		*fbPair = old;
+		__asm__ volatile("dsb sy" ::: "memory");
+		IOLog("J3 GPU: framebuffer GPU write %s old=%#llx gpu=%#llx target=%#llx restored=yes\n",
+		    fbVerified ? "PASS" : "FAILED", old, gpu, fbTarget);
+	}
+	j3_mali_as0_unmap(mali);
+	IOLog("J3 GPU: real-job summary RAM=%s FB=%s; CPU present remains active\n",
+	    ramVerified ? "PASS" : "FAIL", fbVerified ? "PASS" : "FAIL");
+	return ramVerified && fbVerified;
+}
+
+/*
+ * Credit-efficient validation ladder. Every stage uses public Midgard
+ * register/job formats and stops safely on failure.
+ */
+static bool
+j3_mali_validate_ladder(vm_offset_t mali)
+{
+	j3_gpu_write(mali, J3_MALI_GPU_IRQ_MASK, 0);
+	j3_gpu_write(mali, J3_MALI_GPU_IRQ_CLEAR, J3_MALI_GPU_IRQ_KNOWN);
+	j3_gpu_write(mali, J3_MALI_GPU_COMMAND, J3_MALI_CMD_SOFT_RESET);
+	if (!j3_gpu_wait_mask(mali, J3_MALI_GPU_IRQ_RAWSTAT,
+	    J3_MALI_RESET_COMPLETED, J3_MALI_RESET_COMPLETED, 1000000u)) {
+		IOLog("J3 GPU: ladder STOP reset timeout raw=%#x status=%#x\n",
+		    j3_gpu_read(mali, J3_MALI_GPU_IRQ_RAWSTAT),
+		    j3_gpu_read(mali, J3_MALI_GPU_STATUS));
+		return false;
+	}
+	j3_gpu_write(mali, J3_MALI_GPU_IRQ_CLEAR, J3_MALI_RESET_COMPLETED);
+	IOLog("J3 GPU: ladder 1/5 reset PASS id=%#x\n",
+	    j3_gpu_read(mali, J3_MALI_GPU_ID));
+
+	uint32_t shader = j3_gpu_read(mali, J3_MALI_SHADER_PRESENT);
+	uint32_t tiler = j3_gpu_read(mali, J3_MALI_TILER_PRESENT);
+	uint32_t l2 = j3_gpu_read(mali, J3_MALI_L2_PRESENT);
+	if (!shader || !tiler || !l2) {
+		IOLog("J3 GPU: ladder STOP invalid core masks shader=%#x tiler=%#x l2=%#x\n",
+		    shader, tiler, l2);
+		return false;
+	}
+
+	/* Powering the tiler brings L2 slice 0 with it; explicitly request any
+	 * additional L2 slices, matching the open Midgard PM state machine. */
+	j3_gpu_write(mali, J3_MALI_TILER_PWRON, tiler);
+	if (l2 & ~1u) {
+		j3_gpu_write(mali, J3_MALI_L2_PWRON, l2 & ~1u);
+	}
+	bool l2ok = j3_gpu_wait_mask(mali, J3_MALI_TILER_READY,
+	    tiler, tiler, 1000000u) &&
+	    j3_gpu_wait_mask(mali, J3_MALI_L2_READY, l2, l2, 1000000u);
+	if (!l2ok) {
+		IOLog("J3 GPU: ladder STOP L2/tiler on ready=%#x/%#x trans=%#x/%#x expected=%#x/%#x\n",
+		    j3_gpu_read(mali, J3_MALI_L2_READY),
+		    j3_gpu_read(mali, J3_MALI_TILER_READY),
+		    j3_gpu_read(mali, J3_MALI_L2_PWRTRANS),
+		    j3_gpu_read(mali, J3_MALI_TILER_PWRTRANS), l2, tiler);
+		return false;
+	}
+	IOLog("J3 GPU: ladder 2/5 L2+tiler PASS l2=%#x tiler=%#x\n", l2, tiler);
+
+	j3_gpu_write(mali, J3_MALI_SHADER_PWRON, shader);
+	if (!j3_gpu_wait_mask(mali, J3_MALI_SHADER_READY,
+	    shader, shader, 1000000u)) {
+		IOLog("J3 GPU: ladder STOP shaders on ready=%#x trans=%#x expected=%#x\n",
+		    j3_gpu_read(mali, J3_MALI_SHADER_READY),
+		    j3_gpu_read(mali, J3_MALI_SHADER_PWRTRANS), shader);
+		return false;
+	}
+	IOLog("J3 GPU: ladder 3/5 shaders PASS mask=%#x\n", shader);
+
+	j3_gpu_write(mali, J3_MALI_GPU_COMMAND, J3_MALI_CMD_CYCLE_START);
+	uint64_t c0 = j3_gpu_read64(mali, J3_MALI_CYCLE_COUNT_LO,
+	    J3_MALI_CYCLE_COUNT_HI);
+	for (unsigned n = 0; n < 50000u; n++) {
+		__asm__ volatile("yield");
+	}
+	uint64_t c1 = j3_gpu_read64(mali, J3_MALI_CYCLE_COUNT_LO,
+	    J3_MALI_CYCLE_COUNT_HI);
+	j3_gpu_write(mali, J3_MALI_GPU_COMMAND, J3_MALI_CMD_CYCLE_STOP);
+	if (c1 <= c0) {
+		IOLog("J3 GPU: ladder STOP cycle counter stalled start=%#llx end=%#llx\n",
+		    c0, c1);
+		return false;
+	}
+	IOLog("J3 GPU: ladder 4/5 clock PASS cycles=%llu\n", c1 - c0);
+
+	IOLog("J3 GPU: ladder caps js=%#x js0=%#x js1=%#x js2=%#x jobirq=%#x mmuirq=%#x as0_status=%#x as0_transcfg=%#x\n",
+	    j3_gpu_read(mali, J3_MALI_JS_PRESENT),
+	    j3_gpu_read(mali, J3_MALI_JS0_FEATURES),
+	    j3_gpu_read(mali, J3_MALI_JS1_FEATURES),
+	    j3_gpu_read(mali, J3_MALI_JS2_FEATURES),
+	    j3_gpu_read(mali, J3_MALI_JOB_IRQ_STATUS),
+	    j3_gpu_read(mali, J3_MALI_MMU_IRQ_STATUS),
+	    j3_gpu_read(mali, J3_MALI_AS0_STATUS),
+	    j3_gpu_read(mali, J3_MALI_AS0_TRANSCFG));
+	IOLog("J3 GPU: ladder 5/5 capability snapshot PASS\n");
+
+	bool jobsOK = j3_mali_real_job_tests(mali);
+	IOLog("J3 GPU: real jobs %s; framebuffer presentation still CPU\n",
+	    jobsOK ? "PASS" : "FAILED");
 
 	/* Return to a low-power diagnostic state: shaders first, then L2.
 	 * The documented Midgard PM sequence powers the tiler down with L2. */
