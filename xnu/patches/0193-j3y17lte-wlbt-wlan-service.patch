+static bool
+j3_stream_push(struct j3_stream *s, const uint8_t packet[8])
+{
+	volatile uint32_t *ridxp =
+	    (volatile uint32_t *)(j3_wlbt_shared + s->read_index_loc);
+	volatile uint32_t *widxp =
+	    (volatile uint32_t *)(j3_wlbt_shared + s->write_index_loc);
+	uint32_t ridx = *ridxp;
+	uint32_t widx = *widxp;
+	__asm__ volatile("dmb ish" ::: "memory");
+	if (ridx >= s->num_packets || widx >= s->num_packets ||
+	    s->packet_size != sizeof(uint64_t) ||
+	    ((widx + 1u) % s->num_packets) == ridx) {
+		return false;
+	}
+	memcpy(j3_wlbt_shared + s->buffer_loc + widx * s->packet_size,
+	    packet, 8);
+	*widxp = (widx + 1u) % s->num_packets;
+	__asm__ volatile("dsb sy" ::: "memory");
+	j3_kick_r4(s->write_bit);
+	return true;
+}
+
+static uint32_t
+j3_shared_alloc(uint32_t size, uint32_t align)
+{
+	uint32_t mask = align - 1u;
+	uint32_t off = (j3_wlbt_heap_cursor + mask) & ~mask;
+	if (align == 0 || off >= J3_WLBT_SHARED_SIZE ||
+	    size > J3_WLBT_SHARED_SIZE - off) {
+		return 0xffffffffu;
+	}
+	j3_wlbt_heap_cursor = off + size;
+	return off;
+}
