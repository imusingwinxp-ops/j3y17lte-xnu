+static bool
+j3_wlan_prepare(uint32_t *wlan_ref_out)
+{
+	uint32_t wlan_ref = j3_shared_alloc(J3_WLAN_SIZE, 4096);
+	if (wlan_ref == 0xffffffffu) {
+		printf("J3 WLAN: no 1 MiB shared block available\n");
+		return false;
+	}
+	uint8_t *wlan = j3_wlbt_shared + wlan_ref;
+	memset(wlan, 0, J3_WLAN_SIZE);
+
+	uint32_t mib1 = 0;
+	uint32_t mib2 = 0;
+	int error = j3_read_private_file(J3_WLAN_HCF_PATH,
+	    wlan + J3_WLAN_MIB_OFF, J3_WLAN_MIB_SIZE, &mib1);
+	if (error != 0 || mib1 == 0) {
+		printf("J3 WLAN: mandatory private wlan.hcf missing/invalid err=%d\n",
+		    error);
+		return false;
+	}
+	if (mib1 < J3_WLAN_MIB_SIZE) {
+		error = j3_read_private_file(J3_WLAN_SW_HCF_PATH,
+		    wlan + J3_WLAN_MIB_OFF + mib1,
+		    J3_WLAN_MIB_SIZE - mib1, &mib2);
+		if (error != 0) {
+			mib2 = 0;
+		}
+	}
+	uint32_t mib_total = mib1 + mib2;
+	struct j3_hip_control *hip =
+	    (struct j3_hip_control *)(wlan + J3_WLAN_CONFIG_OFF);
+	memset(hip, 0, J3_WLAN_CONFIG_SIZE);
+	j3_hip_fill_config(&hip->config_v3, 3, wlan_ref, mib_total);
+	j3_hip_fill_config(&hip->config_v4, 4, wlan_ref, mib_total);
+	hip->init_magic = J3_HIP_INIT_MAGIC;
+	hip->version_a_ref = wlan_ref + 160u;
+	hip->version_b_ref = wlan_ref + 32u;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	printf("J3 WLAN: HIP prepared ref=%#x mib=%u+%u fh=%u th=%u\n",
+	    wlan_ref, mib1, mib2, J3_HIP_FROMHOST_BIT, J3_HIP_TOHOST_BIT);
+	*wlan_ref_out = wlan_ref;
+	return true;
+}
+
+static bool
+j3_wlan_send_start(uint32_t wlan_ref)
+{
+	uint8_t packet[8] = {0};
+	packet[0] = J3_SM_CHAN;
+	packet[1] = J3_SERVICE_WLAN;
+	packet[2] = J3_SM_START_REQ;
+	packet[3] = (uint8_t)(wlan_ref);
+	packet[4] = (uint8_t)(wlan_ref >> 8);
+	packet[5] = (uint8_t)(wlan_ref >> 16);
+	packet[6] = (uint8_t)(wlan_ref >> 24);
+	return j3_stream_push(&j3_mgmt_out, packet);
+}
+
+static bool
+j3_wlan_wait_start_cfm(uint32_t wlan_ref)
+{
+	struct j3_hip_control *hip =
+	    (struct j3_hip_control *)(j3_wlbt_shared + wlan_ref);
+	for (unsigned int tick = 0; tick < 500; tick++) {
+		uint8_t msg[8];
+		while (j3_stream_pop(&j3_mgmt_in, msg)) {
+			if (msg[0] == J3_SM_CHAN &&
+			    msg[1] == J3_SERVICE_WLAN &&
+			    msg[2] == J3_SM_START_CFM) {
+				for (unsigned int ver_tick = 0; ver_tick < 200; ver_tick++) {
+					uint32_t ver = hip->conf_hip4_ver;
+					__asm__ volatile("dmb ish" ::: "memory");
+					if (ver == 3 || ver == 4) {
+						printf("J3 WLAN: START_CFM HIP%u selected\n", ver);
+						return true;
+					}
+					j3_wlbt_sleep_ms(10);
+				}
+				printf("J3 WLAN: START_CFM but no supported HIP version\n");
+				return false;
+			}
+			printf("J3 WLAN: mgmt ch=%u service=%u msg=%u\n",
+			    msg[0], msg[1], msg[2]);
+		}
+		j3_wlbt_sleep_ms(10);
+	}
+	return false;
+}
+
+static bool
+j3_wlan_service_start(void)
+{
+	uint32_t wlan_ref;
+	if (!j3_wlan_prepare(&wlan_ref)) {
+		return false;
+	}
+	if (!j3_wlan_send_start(wlan_ref)) {
+		printf("J3 WLAN: management TX ring full\n");
+		return false;
+	}
+	printf("J3 WLAN: START_REQ sent ref=%#x\n", wlan_ref);
+	if (!j3_wlan_wait_start_cfm(wlan_ref)) {
+		printf("J3 WLAN: START_CFM timeout/failure\n");
+		return false;
+	}
+	j3_wlan_ref = wlan_ref;
+	return true;
+}
