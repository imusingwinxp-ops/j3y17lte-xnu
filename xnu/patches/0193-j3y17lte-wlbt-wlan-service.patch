+static void
+j3_hip_fill_config(struct j3_hip_config *cfg, uint16_t version,
+	uint32_t wlan_ref, uint32_t mib_len)
+{
+	memset(cfg, 0, sizeof(*cfg));
+	cfg->magic_number = J3_HIP_CONFIG_MAGIC;
+	cfg->hip_config_ver = version;
+	cfg->config_len = sizeof(*cfg);
+	cfg->host_cache_line = 64;
+	cfg->host_buf_loc = wlan_ref + J3_WLAN_TX_OFF;
+	cfg->host_buf_sz = J3_WLAN_TX_SIZE;
+	cfg->fw_buf_loc = wlan_ref + J3_WLAN_RX_OFF;
+	cfg->fw_buf_sz = J3_WLAN_RX_SIZE;
+	if (mib_len != 0) {
+		cfg->mib_loc = wlan_ref + J3_WLAN_MIB_OFF;
+		cfg->mib_sz = mib_len;
+	}
+	cfg->mif_fh_int_n = J3_HIP_FROMHOST_BIT;
+	cfg->mif_th_int_n = J3_HIP_TOHOST_BIT;
+	cfg->scbrd_loc = wlan_ref + 320u;
+	cfg->q_num = 6;
+	cfg->q_len = 256;
+	cfg->q_idx_sz = 1;
+	for (unsigned int i = 0; i < 6; i++) {
+		cfg->q_loc[i] = wlan_ref + 1344u + i * 1088u;
+	}
+}
